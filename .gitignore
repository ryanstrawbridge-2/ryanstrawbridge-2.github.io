# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables — secrets must never be committed
.env
.env.local
.env.*.local
.env.production


# local photo staging — full-resolution originals, resized into src/assets before use
portfolio-photos/
# intake queue for `npm run photos` (originals, plus _done/ after processing)
photo-inbox/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# LaTeX build artifacts (the .tex and the .pdf are the deliverables)
resume/*.aux
resume/*.log
resume/*.out
resume/*.fls
resume/*.fdb_latexmk
resume/*.synctex.gz

# studio undo: deleted media is moved here so an undo can put it back
.photo-trash/

# Diagram decks (edited in Google Slides; exported PNGs go through the photo inbox)
diagrams/*.pptx
diagrams/node_modules/
diagrams/.render/

