{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/fix-cms-paths.mjs && astro dev",
    "dev:tina": "node scripts/fix-cms-paths.mjs && tinacms dev -c \"astro dev\"",
    "studio": "bash scripts/studio.sh",
    "build": "node scripts/fix-cms-paths.mjs && astro build && node scripts/prune-unreferenced-assets.mjs && node scripts/generate-cms-thumbnails.mjs",
    "build:tina": "tinacms build && node scripts/fix-cms-paths.mjs && astro build && node scripts/prune-unreferenced-assets.mjs && node scripts/generate-cms-thumbnails.mjs",
    "fix:paths": "node scripts/fix-cms-paths.mjs",
    "photos": "node scripts/media-intake.mjs",
    "model": "node scripts/model-intake.mjs",
    "photos:shrink": "node scripts/media-intake.mjs --shrink",
    "check:tina": "node scripts/check-tina-fragment.mjs",
    "check:media": "node scripts/check-media-layout.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "tina": "tinacms",
    "publish": "bash scripts/publish.sh",
    "resume": "bash scripts/update-resume.sh",
    "resume:build": "bash scripts/update-resume.sh --local"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@google/model-viewer": "^4.4.0",
    "@tinacms/cli": "^2.2.6",
    "astro": "^6.3.1",
    "tinacms": "^3.7.6"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "draco3dgltf": "^1.5.9"
  }
}
