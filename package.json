{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/fix-cms-paths.mjs && astro dev",
    "studio": "bash scripts/studio.sh",
    "build": "node scripts/fix-cms-paths.mjs && astro build && node scripts/prune-unreferenced-assets.mjs",
    "fix:paths": "node scripts/fix-cms-paths.mjs",
    "photos": "node scripts/media-intake.mjs",
    "photos:sort": "node scripts/sort-inbox.mjs",
    "model": "node scripts/model-intake.mjs",
    "photos:shrink": "node scripts/media-intake.mjs --shrink",
    "check:media": "node scripts/check-media-layout.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "publish": "bash scripts/publish.sh",
    "resume": "bash scripts/update-resume.sh",
    "resume:build": "bash scripts/update-resume.sh --local",
    "check:copy": "node scripts/check-placeholder-copy.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@google/model-viewer": "^4.4.0",
    "astro": "^6.3.1",
    "meshoptimizer": "^1.3.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "draco3dgltf": "^1.5.9"
  }
}
