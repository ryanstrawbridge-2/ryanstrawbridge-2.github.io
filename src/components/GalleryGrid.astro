---
/**
 * Renders a group of gallery items as a 6-column grid. Items span 6/3/2
 * columns for full/half/third, so widths can be mixed freely in one group.
 *
 * Used twice on a project page: once inline after each body section, once for
 * the items that didn't name a section. Both live inside the page's single
 * [data-lightbox-root] so the lightbox treats them as one set.
 */
import { Image } from 'astro:assets';
import { focalCss, videoSrc, type GalleryItem } from '../lib/gallery';

interface Props {
  items: GalleryItem[];
  /** Builds the data-tina-field path for a row, e.g. (i) => f('gallery', i, 'image') */
  field?: (index: number, key: string) => string | undefined;
  class?: string;
}

const { items, field, class: className = '' } = Astro.props;

// The live editor (npm run studio) reads these to know which row it's editing.
// Dev only — they must not reach the deployed HTML.
const studio = import.meta.env.DEV;
---

{
  items.length > 0 && (
    <div class:list={['gallery-grid', className]}>
      {items.map((item) => (
        <figure
          class:list={['gallery-figure', `g-${item.width}`, item.ratio && 'is-framed']}
          style={[
            `--focal: ${focalCss(item.focal)};`,
            `--zoom: ${item.zoom};`,
            item.ratio ? `--ratio: ${item.ratio};` : '',
          ].join('')}
          data-tina-field={field?.(item.index, item.video ? 'video' : 'image')}
          {...studio && {
            'data-studio-index': String(item.index),
            'data-studio-width': item.width,
            'data-studio-focal': item.focal,
            'data-studio-zoom': String(item.zoom),
            'data-studio-aspect': item.aspect,
            'data-studio-section': item.sectionId,
            'data-studio-kind': item.video ? 'video' : 'image',
            'data-studio-alt': item.alt ?? '',
          }}
        >
          <div class="gallery-frame">
          {item.video ? (
            <video
              controls
              preload="metadata"
              playsinline
              poster={item.poster?.src}
              aria-label={item.alt ?? item.caption ?? 'Project video'}
            >
              <source src={videoSrc(item.video)} type="video/mp4" />
            </video>
          ) : (
            /* Full-width cells reach ~1100px in the narrow container; half and
               third cap near 540 and 350. 1200w covers full 1x and half 2x. */
            <Image
              src={item.image!}
              alt={item.alt ?? item.caption ?? ''}
              widths={item.width === 'full' ? [600, 1200] : [400, 800]}
              sizes={
                item.width === 'full'
                  ? '(min-width: 760px) 760px, 100vw'
                  : '(min-width: 720px) 50vw, 100vw'
              }
              loading="lazy"
            />
          )}
          </div>
          {(item.caption ?? item.alt) && (
            <figcaption>{item.caption ?? item.alt}</figcaption>
          )}
        </figure>
      ))}
    </div>
  )
}

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.5rem 1.25rem;
    align-items: start;
  }

  .g-full {
    grid-column: span 6;
  }
  .g-half {
    grid-column: span 3;
  }
  .g-third {
    grid-column: span 2;
  }

  @media (max-width: 720px) {
    .g-half,
    .g-third {
      grid-column: span 6;
    }
  }

  .gallery-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* The frame is what crops. The image scales inside it, so zoom clips at the
     frame edge instead of pushing the grid around. */
  .gallery-frame {
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    line-height: 0;
  }
  .gallery-figure.is-framed .gallery-frame {
    aspect-ratio: var(--ratio);
  }

  .gallery-figure :global(img),
  .gallery-figure video {
    margin: 0;
    width: 100%;
    display: block;
    /* Anchored on the focal point, so zooming pushes away from what you
       centred rather than away from the middle of the frame. */
    transform: scale(var(--zoom, 1));
    transform-origin: var(--focal, center center);
  }

  /* A framed cell crops to its ratio; --focal picks what survives. */
  .gallery-figure.is-framed :global(img) {
    height: 100%;
    object-fit: cover;
    object-position: var(--focal, center center);
    cursor: zoom-in;
  }

  /* Unframed full-width cells keep their natural shape — this is where a tall
     sketch or a wide CAD render goes. max-height stops a portrait photo
     running off the screen; `contain` keeps its proportions while it does. */
  .g-full:not(.is-framed) :global(img) {
    height: auto;
    max-height: 620px;
    object-fit: contain;
    cursor: zoom-in;
  }

  .gallery-figure video {
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--bg-elevated);
  }
  .gallery-figure.is-framed video { aspect-ratio: var(--ratio); height: 100%; }
  .g-full video {
    max-height: 620px;
  }

  .gallery-figure figcaption {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-align: center;
    margin-top: 0.5rem;
    padding-inline: 0.25rem;
  }
</style>

<style>
  /* Spacing differs by where the group sits: inline groups breathe on both
     sides, the trailing group only needs room before the page nav. */
  .gallery-grid.section-gallery {
    margin-block: 1.75rem;
  }
  .gallery-grid.trailing-gallery {
    margin-block: 0 4rem;
  }
</style>
