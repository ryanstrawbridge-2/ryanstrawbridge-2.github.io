---
/**
 * Live editor overlay. Renders ONLY in `astro dev`, so nothing here reaches the
 * deployed site — the production build emits an empty string.
 *
 * Pairs with scripts/studio-server.mjs: this is the UI, that is the writer.
 * Every control changes the page immediately and saves in the background, so
 * you see the real crop while you drag it instead of after a save-and-look.
 */
interface Props {
  /** Heading ids on this page, for the "move to section" menu. */
  headings?: string[];
  /** 'project' edits a gallery list; 'home' edits fixed slots in home.json. */
  mode?: 'project' | 'home';
}
const { headings = [], mode = 'project' } = Astro.props;
const enabled = import.meta.env.DEV;
const studioPort = Number(import.meta.env.STUDIO_PORT ?? 4322);
---

{
  enabled && (
    <div
      id="studio"
      data-port={studioPort}
      data-mode={mode}
      data-headings={JSON.stringify(headings)}
      hidden
    >
      <div class="studio-bar" role="toolbar" aria-label="Studio">
        <span class="studio-brand"><span class="studio-dot" />Studio</span>
        <span class="studio-sep" />
        <button type="button" class="studio-btn studio-library-open" title="Browse photos and video">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2.5" /><circle cx="9" cy="9" r="1.8" /><path d="m21 15-3.6-3.6a1.8 1.8 0 0 0-2.5 0L5 21" /></svg>
          <span>Media</span>
        </button>
        <button type="button" class="studio-btn studio-text" aria-pressed="false" title="Click any text on the page to edit it">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7V4.5h16V7" /><path d="M12 4.5v15" /><path d="M9 19.5h6" /></svg>
          <span>Text</span>
        </button>
        <button type="button" class="studio-btn studio-add-section" title="Add a section: cards, stats, gallery, video, banner and more">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="4" width="17" height="16" rx="2.5" /><path d="M12 8.5v7M8.5 12h7" /></svg>
          <span>Section</span>
        </button>
        <button type="button" class="studio-btn studio-layout" aria-pressed="false" title="Drag spacing, gaps, splits and section order, with gridlines (L)">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2.5" /><path d="M3 9h18M9 9v12" /></svg>
          <span>Layout</span>
        </button>
        <button type="button" class="studio-btn studio-theme" title="Colours, corners and type">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h9M17 6h3M4 12h3M11 12h9M4 18h11M19 18h1" /><circle cx="15" cy="6" r="2" /><circle cx="9" cy="12" r="2" /><circle cx="17" cy="18" r="2" /></svg>
          <span>Theme</span>
        </button>
        <button type="button" class="studio-btn studio-phone" title="See this page at phone width">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2.2" /><path d="M11 18h2" /></svg>
          <span>Phone</span>
        </button>
        <span class="studio-sep" />
        <button type="button" class="studio-btn studio-undo" title="Undo the last edit (⌘Z)" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 14 4 9l5-5" /><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11" /></svg>
          <span class="studio-undo-label">Undo</span>
        </button>
        <span class="studio-pair">
          <button type="button" class="studio-btn studio-icon studio-redo" title="Nothing to redo" aria-label="Redo" disabled>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 14 5-5-5-5" /><path d="M20 9H9.5a5.5 5.5 0 0 0 0 11H13" /></svg>
          </button>
          <button type="button" class="studio-btn studio-icon studio-history-open" title="Edit history" aria-label="Edit history">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></svg>
          </button>
        </span>
        <span class="studio-help">
          <button type="button" class="studio-btn studio-icon" aria-label="How to edit" aria-describedby="studio-hint">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M9.2 9.2a2.9 2.9 0 0 1 5.6 1c0 1.9-2.8 2.6-2.8 2.6" /><path d="M12 17h.01" /></svg>
          </button>
          <span class="studio-hint" id="studio-hint" role="tooltip">
            {mode === 'home'
              ? 'Hover between sections for + Add section · click a section to edit it in the side panel · drag a photo to crop, ⌥scroll to zoom · Layout (L) drags spacing, gaps and order'
              : 'Click a figure or section to edit it in the side panel · + Add section at the end of each heading · drag a photo to crop, ⌥scroll to zoom · drop files to add them'}
            <span class="studio-keys"><kbd>T</kbd> text {mode === 'home' && <><kbd>L</kbd> layout </>}<kbd>P</kbd> preview <kbd>⌘S</kbd> save <kbd>⌘Z</kbd> undo <kbd>⌘⇧Z</kbd> redo <kbd>Esc</kbd> close / deselect <kbd>⌫</kbd> delete selected figure</span>
          </span>
        </span>
        <button type="button" class="studio-btn studio-primary studio-save" title="Save a checkpoint on this Mac. Nothing goes live.">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3.5h11l3.5 3.5v11.5A2 2 0 0 1 17.5 20.5h-11A2 2 0 0 1 4.5 18.5V5.5a2 2 0 0 1 .5-2Z" /><path d="M8 3.5v5h7v-5" /><path d="M8 20.5v-6h8v6" /></svg>
          <span>Save</span>
          <b class="studio-save-count" hidden />
        </button>
        <button type="button" class="studio-btn studio-publish" title="Push saved work to the live site">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 14V3.5" /><path d="m7.5 8 4.5-4.5L16.5 8" /><path d="M4 14.5v4A2.5 2.5 0 0 0 6.5 21h11a2.5 2.5 0 0 0 2.5-2.5v-4" /></svg>
          <span>Go live</span>
        </button>
        <button type="button" class="studio-btn studio-icon studio-off" title="Hide until reload" aria-label="Hide studio">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
        </button>
      </div>
      <div class="studio-toast" role="status" aria-live="polite" hidden />

      <div class="studio-panel studio-theme-panel" hidden>
        <header>
          <strong>Theme</strong>
          <span class="studio-theme-note">site-wide</span>
          <button type="button" class="studio-btn studio-icon studio-theme-close" aria-label="Close">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
          </button>
        </header>
        <div class="studio-theme-body">
          <label>Accent
            <span class="studio-swatches" />
            <input type="color" class="studio-accent" />
          </label>
          <label>Corners
            <select class="studio-corners">
              <option value="sharp">Sharp</option>
              <option value="soft">Soft</option>
              <option value="round">Round</option>
            </select>
          </label>
          <label>Headings
            <select class="studio-headfont">
              <option value="sans">Sans</option>
              <option value="serif">Serif</option>
              <option value="mono">Mono</option>
            </select>
          </label>
          <label>Page width
            <select class="studio-width-setting">
              <option value="narrow">Narrow · 960</option>
              <option value="standard">Standard · 1100</option>
              <option value="wide">Wide · 1280</option>
            </select>
          </label>
        </div>
        <footer><span class="studio-theme-state">Changes preview instantly and save as you make them.</span></footer>
      </div>

      <div class="studio-panel studio-phone-panel" hidden>
        <header>
          <strong>Phone preview</strong>
          <select class="studio-phone-size">
            <option value="390x844">iPhone 15 · 390</option>
            <option value="375x812">iPhone SE / 13 mini · 375</option>
            <option value="430x932">iPhone Pro Max · 430</option>
            <option value="768x1024">iPad · 768</option>
          </select>
          <button type="button" class="studio-btn studio-icon studio-phone-reload" title="Reload the preview" aria-label="Reload">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8 8 0 1 0-2.3 5.7" /><path d="M20 4v7h-7" /></svg>
          </button>
          <button type="button" class="studio-btn studio-icon studio-phone-close" aria-label="Close">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
          </button>
        </header>
        <iframe class="studio-phone-frame" title="Phone preview" />
      </div>

      <div class="studio-panel studio-history-panel" hidden>
        <header>
          <strong>History</strong>
          <span class="studio-theme-note">click an edit to undo back to before it</span>
          <button type="button" class="studio-btn studio-icon studio-history-close" aria-label="Close">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
          </button>
        </header>
        <ol class="studio-history-list" />
      </div>

      <div class="studio-panel studio-save-panel" hidden>
        <header>
          <strong>Save on this Mac</strong>
          <span class="studio-save-branch" />
          <button type="button" class="studio-btn studio-icon studio-save-close" aria-label="Close">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
          </button>
        </header>
        <section class="studio-save-section">
          <h4 class="studio-save-h">Not saved yet</h4>
          <ul class="studio-save-changes" />
        </section>
        <label class="studio-pub-msg">
          <span>Note <em>optional</em></span>
          <input type="text" class="studio-input studio-save-msg" placeholder="Named after what changed if left blank" />
        </label>
        <footer>
          <span class="studio-pub-state studio-save-state">A checkpoint on this Mac. Nothing goes to the live site.</span>
          <button type="button" class="studio-btn studio-primary studio-save-go">Save</button>
        </footer>
        <section class="studio-save-section studio-save-history">
          <h4 class="studio-save-h">Saved <span class="studio-save-notlive" /></h4>
          <ol class="studio-save-list" />
        </section>
      </div>

      <div class="studio-panel studio-publish-panel" hidden>
        <header>
          <strong>Go live</strong>
          <button type="button" class="studio-btn studio-icon studio-pub-close" aria-label="Close">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
          </button>
        </header>
        <label class="studio-pub-msg">
          <span>What changed?</span>
          <input type="text" class="studio-input" placeholder="Content update" />
        </label>
        <div class="studio-pub-log" hidden />
        <footer>
          <span class="studio-pub-state">Puts your saves (and anything unsaved) on the public site. Asks first.</span>
          <button type="button" class="studio-btn studio-primary studio-pub-go">Go live</button>
        </footer>
      </div>
      <div class="studio-drop" hidden><span>Drop to add to this project</span></div>

      <div class="studio-library" hidden>
        <header>
          <div class="studio-lib-title">
            <strong>Media library</strong>
            <span class="studio-lib-target">Pick a file to add it to this page</span>
          </div>
          <label class="studio-lib-opt">Section <select class="studio-lib-section"></select></label>
          <label class="studio-lib-opt">Width <select class="studio-lib-width">
            <option value="">Page default</option>
            <option value="full">Full</option>
            <option value="half">Half</option>
            <option value="third">Third</option>
          </select></label>
          <button type="button" class="studio-btn studio-icon studio-lib-close" aria-label="Close library">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
          </button>
        </header>
        <div class="studio-lib-body">
          <nav class="studio-lib-folders" />
          <div class="studio-lib-grid" />
        </div>
      </div>
    </div>
  )
}

{/* Styles and behaviour live in scripts/studio/ and are served by the writer
    (port 4322). Only astro dev renders these tags, so the overlay code is not
    part of the site build at all, rather than merely hidden. */}
{enabled && <link rel="stylesheet" href={`http://127.0.0.1:${studioPort}/overlay/overlay.css`} />}
{enabled && <script is:inline type="module" src={`http://127.0.0.1:${studioPort}/overlay/main.js`} />}

<script>
  // Skip the full-page reload Astro sends after a "quiet" studio save (a crop,
  // zoom, marker move or in-place text edit the page already shows). Vite's
  // client reloads unless the payload names an .html page that isn't this
  // one, so pointing it elsewhere cancels that one reload and nothing else.
  // import.meta.hot is undefined in a build, so this compiles to nothing.
  if (import.meta.hot) {
    import.meta.hot.on('vite:beforeFullReload', (payload: { path?: string }) => {
      const until = (window as unknown as { __studioQuietUntil?: number }).__studioQuietUntil ?? 0;
      if (until > Date.now()) payload.path = '/__studio-quiet.html';
    });
  }
</script>
