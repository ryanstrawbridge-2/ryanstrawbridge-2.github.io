  .studio-zoom-badge:hover { background: var(--st-accent); }
  .studio-zoom-badge:hover::after { color: white; }
  .studio-zoom-badge[hidden] { display: none; }

  .studio-crosshair {
    position: absolute; z-index: 4;
    width: 22px; height: 22px; margin: -11px 0 0 -11px;
    border-radius: 50%;
    border: 2px solid white;
