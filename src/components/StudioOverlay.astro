  @media (prefers-reduced-motion: reduce) {
    .studio-toast, .studio-panel, .studio-library { animation: none; }
    .studio-tools, .studio-hint { transition: none; }
  }
</style>
)}

{enabled && (
<script is:inline>
  const root = document.getElementById('studio');
  // ?studio=off suppresses the overlay. The phone preview loads this same page
  // in an iframe, and a second editor inside it would both cover the layout
  // being inspected and bind a duplicate set of handlers.
  if (root && new URLSearchParams(location.search).get('studio') === 'off') {
    root.remove();
  } else if (root) {
    const PORT = root.dataset.port || '4322';
    const API = `http://127.0.0.1:${PORT}`;
    const HEADINGS = JSON.parse(root.dataset.headings || '[]');
    const slug = document.querySelector('[data-studio-slug]')?.getAttribute('data-studio-slug');
    const MODE = root.dataset.mode || 'project';

    const bar = root.querySelector('.studio-bar');
    const toastEl = root.querySelector('.studio-toast');
    const dropEl = root.querySelector('.studio-drop');

    // Dragging an <img> that is already on the page reports a 'Files' type in
    // Chrome, so without this a stray drag on a photo tried to upload the page
    // back to itself ("_image isn't an image"). Only drags from outside count.
    let internalDrag = false;
    document.addEventListener('dragstart', () => { internalDrag = true; });
    document.addEventListener('dragend', () => { internalDrag = false; });
    window.addEventListener('drop', () => { setTimeout(() => { internalDrag = false; }, 0); }, true);
    const isFileDrag = (event) =>
      !internalDrag && [...(event.dataTransfer?.types || [])].includes('Files');

    const readAsBase64 = (file) =>
      new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(String(reader.result).split(',')[1]);
        reader.onerror = () => reject(new Error(`could not read ${file.name}`));
        reader.readAsDataURL(file);
      });

    /** What happened to the file a replacement pushed out. */
    const displacedNote = (d) =>
      !d ? '' : d.deleted ? ` · removed ${d.file}` : ` · ${d.file} is now unused`;

    const size = (n) =>
      n >= 1024 * 1024 ? `${(n / 1024 / 1024).toFixed(1)} MB` : `${Math.round(n / 1024)} KB`;

    // Stroke icons, 24-unit grid, drawn in currentColor. Inline so the overlay
    // has no asset requests and nothing here can reach the production build.
    const ICON = {
      left: '<path d="m15 18-6-6 6-6"/>',
      right: '<path d="m9 18 6-6-6-6"/>',
      trash: '<path d="M4 7h16"/><path d="M9 7V4.5h6V7"/><path d="M6.5 7l.8 12.5a1.5 1.5 0 0 0 1.5 1.5h6.4a1.5 1.5 0 0 0 1.5-1.5L17.5 7"/><path d="M10 11v6M14 11v6"/>',
      alt: '<path d="M4 6h16M4 12h11M4 18h7"/>',
      replace: '<path d="M4 12a8 8 0 0 1 13.7-5.6L20 8.5"/><path d="M20 4v4.5h-4.5"/><path d="M20 12a8 8 0 0 1-13.7 5.6L4 15.5"/><path d="M4 20v-4.5h4.5"/>',
      plus: '<path d="M12 5v14M5 12h14"/>',
      grip: '<circle cx="9" cy="6" r="1.2"/><circle cx="15" cy="6" r="1.2"/><circle cx="9" cy="12" r="1.2"/><circle cx="15" cy="12" r="1.2"/><circle cx="9" cy="18" r="1.2"/><circle cx="15" cy="18" r="1.2"/>',
    };
    const svg = (name) => `<svg viewBox="0 0 24 24" aria-hidden="true">${ICON[name]}</svg>`;

    /** Toolbar button. Icon-only buttons carry their name in aria-label. */
    const toolButton = ({ icon, text, title, className = '' }) => {
      const button = document.createElement('button');
      button.type = 'button';
      if (title) button.title = title;
      if (icon && !text) {
        button.className = `studio-tool-icon ${className}`.trim();
        button.setAttribute('aria-label', title || icon);
        button.innerHTML = svg(icon);
      } else {
        if (className) button.className = className;
        button.innerHTML = icon ? svg(icon) : '';
        button.append(text);
      }
      return button;
    };
    const toolSep = () => Object.assign(document.createElement('span'), { className: 'studio-tool-sep' });

    let toastTimer;
    const toast = (message, isError = false) => {
      toastEl.textContent = message;
      toastEl.classList.toggle('is-error', isError);
      toastEl.hidden = false;
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => { toastEl.hidden = true; }, isError ? 6000 : 2600);
    };

    const undoBtn = root.querySelector('.studio-undo');

    /**
     * Keep the undo button in step with the server's journal.
     *
     * The label names the edit rather than counting them ("undo crop" beats
     * "undo (3)") — you are undoing one specific thing you just did, and the
     * only way to be sure it is the right one is to see it named.
     */
    const setUndo = (state) => {
      if (!undoBtn || !state) return;
      undoBtn.disabled = !state.depth;
      const labelEl = undoBtn.querySelector('.studio-undo-label');
      if (labelEl) labelEl.textContent = state.next ? `Undo ${state.next}` : 'Undo';
      undoBtn.title = state.next
        ? `Undo: ${state.next} (⌘Z)`
        : 'Nothing to undo yet';
    };

    const post = async (path, payload) => {
      const response = await fetch(API + path, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ slug, ...payload }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || `save failed (${response.status})`);
      setUndo(data.undo);
      return data;
    };

    /**
     * Debounced save that can't be lost to a reload.
     *
     * A zoom gesture fires continuously, so the save waits for it to settle.
     * But any save nudges Astro, and the resulting HMR reload can land inside
     * that window and take the pending write with it — the zoom looked
     * applied, then came back at its old value. Pending writes are flushed
     * with sendBeacon on the way out, which survives teardown.
     */
    const pending = new Map();

    const queueSave = (key, path, payload, delay = 400) => {
      const existing = pending.get(key);
      if (existing) clearTimeout(existing.timer);
      const entry = { path, payload };
      entry.timer = setTimeout(async () => {
        pending.delete(key);
        try {
          await post(path, payload);
        } catch (error) { toast(error.message, true); }
      }, delay);
      pending.set(key, entry);
    };

    const flushPending = () => {
      for (const [, { timer, path, payload }] of pending) {
        clearTimeout(timer);
        try {
          navigator.sendBeacon(
            API + path,
            new Blob([JSON.stringify({ slug, ...payload })], { type: 'application/json' }),
          );
        } catch { /* leaving the page anyway */ }
      }
      pending.clear();
    };
    window.addEventListener('pagehide', flushPending);

    let undoing = false;
    const doUndo = async () => {
      if (undoing || undoBtn?.disabled) return;
      undoing = true;
      try {
        const response = await fetch(`${API}/undo`, { method: 'POST' });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.reason || data.error || 'undo failed');
        // The write nudges Astro, so the page is about to reload with the
        // restored file. Say what came back before that happens.
        const bits = [];
        if (data.restoredMedia) bits.push(`${data.restoredMedia} file back`);
        if (data.deleted) bits.push(`${data.deleted} file removed`);
        toast(`undid ${data.label}${bits.length ? ` · ${bits.join(' · ')}` : ''}`);
        if (data.missing?.length)
          toast(`undid ${data.label}, but ${data.missing.length} file could not be restored`, true);
        setUndo({ depth: data.remaining, next: null });
      } catch (error) {
        toast(error.message, true);
      } finally {
        undoing = false;
      }
    };

    undoBtn?.addEventListener('click', doUndo);

    // -- theme ------------------------------------------------------------
    /**
     * Every control previews by setting the custom property on <html> and
     * saves in the background. The reload that follows re-renders from
     * site.json, so what you see mid-drag and what ships are the same values.
     */
    const themePanel = root.querySelector('.studio-theme-panel');
    const accentInput = root.querySelector('.studio-accent');
    const cornersSel = root.querySelector('.studio-corners');
    const headFontSel = root.querySelector('.studio-headfont');
    const widthSel = root.querySelector('.studio-width-setting');
    const swatches = root.querySelector('.studio-swatches');

    const CORNERS = { sharp: ['2px', '4px'], soft: ['6px', '12px'], round: ['12px', '22px'] };
    const WIDTHS = { narrow: '960px', standard: '1100px', wide: '1280px' };
    const HEAD_FONTS = { sans: 'var(--font-sans)', serif: 'var(--font-serif)', mono: 'var(--font-mono)' };
    const PRESETS = ['#c2410c', '#b45309', '#15803d', '#0f766e', '#1d4ed8', '#6d28d9', '#be123c', '#334155'];

    /** Mix a colour toward black or white, for the hover and soft variants. */
    const shade = (hex, amount, toward) => {
      const n = parseInt(hex.slice(1), 16);
      const parts = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((c) =>
        Math.round(c + (toward - c) * amount));
      return `#${parts.map((c) => c.toString(16).padStart(2, '0')).join('')}`;
    };

    const previewAccent = (hex) => {
      const el = document.documentElement;
      el.style.setProperty('--accent', hex);
      el.style.setProperty('--accent-hover', shade(hex, 0.25, 0));
      el.style.setProperty('--accent-soft', shade(hex, 0.88, 255));
      for (const button of swatches.querySelectorAll('button'))
        button.setAttribute('aria-pressed', String(button.dataset.color === hex));
    };

    const saveTheme = (patch, key) =>
      queueSave(`theme:${key}`, '/site/theme', { patch }, 250);

    const setAccent = (hex) => {
      previewAccent(hex);
      accentInput.value = hex;
      saveTheme({
        accentColor: hex,
        accentColorHover: shade(hex, 0.25, 0),
        accentSoft: shade(hex, 0.88, 255),
      }, 'accent');
    };

    for (const color of PRESETS) {
      const button = document.createElement('button');
      button.type = 'button';
      button.dataset.color = color;
      button.style.background = color;
      button.title = color;
      button.setAttribute('aria-pressed', 'false');
      button.addEventListener('click', () => setAccent(color));
      swatches.appendChild(button);
    }

    accentInput?.addEventListener('input', (event) => setAccent(event.target.value));

    cornersSel?.addEventListener('change', () => {
      const [r, rl] = CORNERS[cornersSel.value];
      document.documentElement.style.setProperty('--radius', r);
      document.documentElement.style.setProperty('--radius-lg', rl);
      saveTheme({ cornerStyle: cornersSel.value }, 'corners');
    });

    headFontSel?.addEventListener('change', () => {
      document.documentElement.style.setProperty('--font-heading', HEAD_FONTS[headFontSel.value]);
      saveTheme({ headingFont: headFontSel.value }, 'headfont');
    });

    widthSel?.addEventListener('change', () => {
      document.documentElement.style.setProperty('--container', WIDTHS[widthSel.value]);
      saveTheme({ containerWidth: widthSel.value }, 'width');
    });

    root.querySelector('.studio-theme')?.addEventListener('click', async () => {
      themePanel.hidden = !themePanel.hidden;
      if (themePanel.hidden) return;
      try {
        const { site } = await post('/site/read', {});
        const accent = site.accentColor || '#c2410c';
        accentInput.value = accent;
        for (const button of swatches.querySelectorAll('button'))
          button.setAttribute('aria-pressed', String(button.dataset.color === accent));
        cornersSel.value = site.cornerStyle || 'soft';
        headFontSel.value = site.headingFont || 'sans';
        widthSel.value = site.containerWidth || 'standard';
      } catch (error) { toast(error.message, true); }
    });
    root.querySelector('.studio-theme-close')?.addEventListener('click', () => { themePanel.hidden = true; });

    // -- inline text editing ----------------------------------------------
    /**
     * Any element already carrying a data-tina-field that isn't an image slot
     * becomes editable. index.astro tagged these for click-to-edit, so no new
     * markup was needed — the same reuse that made home-mode cropping cheap.
     *
     * Text is edited from the SOURCE, not from what's on screen: the tagline
     * renders "*bridge*" as italics, and editing the rendered text would eat
     * the asterisks. When source and rendered text agree the field is edited
     * in place; when they differ a small box opens seeded with the source, so
     * the markup is visible and survives.
     */
    // `body` is the whole rendered markdown document, not a field — editing
    // what's on screen would replace the source with its own HTML. It stays a
    // CMS-and-editor job until there's real source mapping.
    const TEXT_SKIP = /(^|\.)(image|photo|logo|headshot|video|alt|href|poster|body|gallery)($|\.)/i;

    const textSlots = () =>
      [...document.querySelectorAll('[data-tina-field]')]
        .map((el) => {
          const raw = el.getAttribute('data-tina-field') || '';
          const home = raw.split('---home.')[1];
          const project = raw.split('---project.')[1];
          return { el, path: home ?? project, isHome: Boolean(home) };
        })
        .filter(({ el, path }) =>
          path && !TEXT_SKIP.test(path) &&
          !el.querySelector('img, video') &&
          el.textContent.trim() !== '');

    const saveText = (slot, value) =>
      slot.isHome
        ? post('/home/patch', { path: slot.path, value })
        : post('/project/patch', { patch: { [slot.path]: value } });

    const readText = (slot) =>
      slot.isHome
        ? post('/home/value', { path: slot.path })
        : post('/project/value', { path: slot.path });

    const editText = async (slot) => {
      const { el } = slot;
      if (el.dataset.studioEditing) return;

      let source;
      try {
        source = (await readText(slot)).value ?? '';
      } catch (error) { toast(error.message, true); return; }

      const rendered = el.textContent.trim();
      const plain = source.trim() === rendered;

      if (plain) {
        // Edit in place. The element keeps its own typography, so what you
        // type is what the page will look like.
        el.dataset.studioEditing = '1';
        el.setAttribute('contenteditable', 'plaintext-only');
        el.classList.add('studio-editing');
        el.focus();

        const done = async (commit) => {
          el.removeAttribute('contenteditable');
          el.classList.remove('studio-editing');
          delete el.dataset.studioEditing;
          const next = el.textContent.trim();
          if (!commit || next === rendered) { el.textContent = rendered; return; }
          try {
            await saveText(slot, next);
            toast('text saved');
          } catch (error) { toast(error.message, true); el.textContent = rendered; }
        };

        el.addEventListener('blur', () => done(true), { once: true });
        el.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') { event.preventDefault(); done(false); el.blur(); }
          // Enter commits on a single-line field; multi-line needs ⌘Enter.
          const multiline = source.includes('\n') || rendered.length > 120;
          if (event.key === 'Enter' && (!multiline || event.metaKey || event.ctrlKey)) {
            event.preventDefault();
            el.blur();
          }
        });
        return;
      }

      // Source and screen disagree — show the source in a box instead.
      el.querySelector('.studio-text-edit')?.remove();
      const box = document.createElement('form');
      box.className = 'studio-text-edit';
      const area = document.createElement('textarea');
      area.value = source;
      area.rows = Math.min(10, Math.max(2, source.split('\n').length + 1));
      area.setAttribute('aria-label', `Edit ${slot.path}`);
      const hint = document.createElement('span');
      hint.textContent = 'markup — ⌘↵ to save, esc to cancel';
      const ok = document.createElement('button');
      ok.type = 'submit';
      ok.textContent = 'save';
      box.append(area, hint, ok);
      el.appendChild(box);
      area.focus();
      area.select();

      const close = () => box.remove();
      box.addEventListener('submit', async (event) => {
        event.preventDefault();
        const value = area.value;
        close();
        try {
          await saveText(slot, value);
          toast('text saved');
        } catch (error) { toast(error.message, true); }
      });
      area.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') { event.preventDefault(); close(); }
        if (event.key === 'Enter' && (event.metaKey || event.ctrlKey)) {
          event.preventDefault();
          box.requestSubmit();
        }
      });
      for (const type of ['pointerdown', 'click']) {
        box.addEventListener(type, (event) => event.stopPropagation());
      }
    };

    let textOn = false;
    const textBtn = root.querySelector('.studio-text');

    const setTextMode = (on) => {
      textOn = on;
      textBtn?.setAttribute('aria-pressed', String(on));
      document.body.classList.toggle('studio-text-mode', on);
      for (const slot of textSlots()) {
        slot.el.classList.toggle('studio-text-slot', on);
        if (on && !slot.el.dataset.studioTextBound) {
          slot.el.dataset.studioTextBound = '1';
          slot.el.addEventListener('click', (event) => {
            if (!textOn) return;
            // A heading that is also a link would navigate instead.
            event.preventDefault();
            event.stopPropagation();
            editText(slot);
          });
        }
      }
      toast(on ? 'text mode — click any text to edit' : 'text mode off');
    };

    textBtn?.addEventListener('click', () => setTextMode(!textOn));

    // -- phone preview ----------------------------------------------------
    // An iframe, not a narrowed container: media queries key off the viewport,
    // and the viewport inside an iframe is the iframe. Anything that merely
    // shrinks a wrapper shows the desktop layout at a smaller size, which is
    // exactly the thing that misleads you about a crop.
    const phonePanel = root.querySelector('.studio-phone-panel');
    const phoneFrame = root.querySelector('.studio-phone-frame');
    const phoneSize = root.querySelector('.studio-phone-size');

    const phoneUrl = () => {
      const url = new URL(location.href);
      url.searchParams.set('studio', 'off'); // no overlay inside the preview
      return url.toString();
    };

    const sizePhone = () => {
      const [w, h] = phoneSize.value.split('x').map(Number);
      // Fit the tallest device into the window with room for the header.
      const scale = Math.min(0.75, (window.innerHeight - 140) / h);
      phoneFrame.width = w;
      phoneFrame.height = h;
      phoneFrame.style.setProperty('--phone-scale', String(scale));
      phoneFrame.parentElement.style.width = `${Math.round(w * scale)}px`;
      phoneFrame.parentElement.style.height = `${Math.round(h * scale) + 36}px`;
    };

    root.querySelector('.studio-phone')?.addEventListener('click', () => {
      phonePanel.hidden = !phonePanel.hidden;
      if (phonePanel.hidden) { phoneFrame.src = 'about:blank'; return; }
      phonePanel.classList.add('studio-phone-shell');
      sizePhone();
      phoneFrame.src = phoneUrl();
    });
    phoneSize?.addEventListener('change', sizePhone);
    window.addEventListener('resize', () => { if (!phonePanel.hidden) sizePhone(); });
    root.querySelector('.studio-phone-reload')?.addEventListener('click', () => {
      phoneFrame.src = phoneUrl();
    });
    root.querySelector('.studio-phone-close')?.addEventListener('click', () => {
      phonePanel.hidden = true;
      phoneFrame.src = 'about:blank';
    });

    // -- publish ----------------------------------------------------------
    // Deliberately two steps. The button opens a panel; publishing happens on
    // a second, separate click. This pushes to a public site, so it shouldn't
    // be one stray click away from the undo button next to it.
    const pubPanel = root.querySelector('.studio-publish-panel');
    const pubLog = root.querySelector('.studio-pub-log');
    const pubState = root.querySelector('.studio-pub-state');
    const pubGo = root.querySelector('.studio-pub-go');
    const pubMsg = root.querySelector('.studio-pub-msg input');
    let pollTimer;

    const renderJob = (data) => {
      if (data.lines?.length) {
        pubLog.hidden = false;
        pubLog.textContent = data.lines.join('\n');
        pubLog.scrollTop = pubLog.scrollHeight;
      }
      if (data.running) {
        pubState.textContent = `publishing… ${data.seconds}s`;
        pubGo.disabled = true;
      } else if (data.code === 0) {
        pubState.textContent = 'pushed. GitHub Actions takes about two minutes.';
        pubGo.disabled = false;
        toast('published');
      } else if (data.code !== null) {
        pubState.textContent = `stopped (exit ${data.code}) — nothing was pushed if it failed before the push step`;
        pubGo.disabled = false;
      }
    };

    const poll = async () => {
      clearTimeout(pollTimer);
      try {
        const data = await (await fetch(`${API}/publish/status`)).json();
        renderJob(data);
        if (data.running) pollTimer = setTimeout(poll, 700);
      } catch { /* server went away; the panel keeps its last state */ }
    };

    root.querySelector('.studio-publish')?.addEventListener('click', () => {
      pubPanel.hidden = !pubPanel.hidden;
      if (!pubPanel.hidden) { pubMsg.focus(); poll(); }
    });
    root.querySelector('.studio-pub-close')?.addEventListener('click', () => { pubPanel.hidden = true; });

    pubGo?.addEventListener('click', async () => {
      pubGo.disabled = true;
      pubLog.hidden = false;
      pubLog.textContent = 'starting…';
      try {
        await post('/publish', { message: pubMsg.value });
        poll();
      } catch (error) {
        pubGo.disabled = false;
        pubState.textContent = error.message;
        toast(error.message, true);
      }
    });

    // Is the writer running? Without it the overlay would look live and do
    // nothing, which is worse than not appearing at all.
    fetch(`${API}/health`)
      .then((r) => r.json())
      .then((health) => { root.hidden = false; setUndo(health.undo); })
      .catch(() => {
        root.hidden = false;
        bar.classList.add('is-offline');
        bar.querySelector('.studio-hint').textContent =
          'writer not running — restart with: npm run studio';
      });

    root.querySelector('.studio-off').addEventListener('click', () => { root.hidden = true; });

    // -- focal keyword <-> percentage -------------------------------------
    const KEYWORD_PCT = {
      'top-left': [0, 0], top: [50, 0], 'top-right': [100, 0],
      left: [0, 50], center: [50, 50], right: [100, 50],
      'bottom-left': [0, 100], bottom: [50, 100], 'bottom-right': [100, 100],
    };
    const toPct = (value) => {
      if (!value) return [50, 50];
      if (KEYWORD_PCT[value]) return KEYWORD_PCT[value];
      const m = String(value).match(/(-?[\d.]+)%\s+(-?[\d.]+)%/);
      return m ? [parseFloat(m[1]), parseFloat(m[2])] : [50, 50];
    };

    /**
     * A replace triggers a save, which reloads the page so you see the real
     * render — and that reload wipes any alt editor opened in the same tick.
     * Park the request across the reload instead. sessionStorage is per-tab and
     * dev-only; if it's unavailable the prompt is simply skipped rather than
     * the whole replace failing.
     */
    const PENDING_ALT = 'studio:pending-alt';
    const parkAltPrompt = (payload) => {
      try { sessionStorage.setItem(PENDING_ALT, JSON.stringify(payload)); } catch {}
    };
    const takeAltPrompt = () => {
      try {
        const raw = sessionStorage.getItem(PENDING_ALT);
        sessionStorage.removeItem(PENDING_ALT);
        return raw ? JSON.parse(raw) : null;
      } catch { return null; }
    };

    /**
     * Inline description editor. Replacing a photo leaves the old alt behind,
     * which is invisible on screen — it only shows up to screen readers and
     * image search — so the editor has to put it in front of you.
     *
     * `save` gets the new text; `current` seeds the box.
     */
    const editAlt = (host, current, save) => {
      host.querySelector('.studio-alt-edit')?.remove();
      const box = document.createElement('form');
      box.className = 'studio-alt-edit';
      const input = document.createElement('input');
      input.type = 'text';
      input.value = current ?? '';
      input.placeholder = 'Describe this photo…';
      input.setAttribute('aria-label', 'Image description');
      const ok = document.createElement('button');
      ok.type = 'submit';
      ok.textContent = 'save';
      box.append(input, ok);
      host.appendChild(box);
      input.focus();
      input.select();

      const close = () => box.remove();
      box.addEventListener('submit', async (event) => {
        event.preventDefault();
        const value = input.value.trim();
        close();
        try {
          await save(value);
          toast(value ? `description → "${value}"` : 'description cleared');
        } catch (error) { toast(error.message, true); }
      });
      input.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') { event.preventDefault(); close(); }
      });
      // Pointer events on the photo would otherwise start a crop drag.
      for (const type of ['pointerdown', 'click']) {
        box.addEventListener(type, (event) => event.stopPropagation());
      }
      return input;
    };

    const figures = () => [...document.querySelectorAll('figure[data-studio-index]')];

    // -- home page: fixed slots, not a list -------------------------------
    //
    // Every editable image on the home page already carries data-tina-field,
    // whose value ends in the JSON path ("...---home.aboutSection.photo").
    // Reusing that meant index.astro needed no new markup at all.
    const HOME_IMAGE_FIELD = /\.(image|photo|logo|headshot|video)$/;
    const homeSlots = () =>
      [...document.querySelectorAll('[data-tina-field*="---home."]')]
        .map((el) => {
          const path = (el.getAttribute('data-tina-field') || '').split('---home.')[1] || '';
          return { el, path };
        })
        .filter(({ el, path }) => HOME_IMAGE_FIELD.test(path) && el.querySelector('img, video'));


    const label = (id) =>
      (document.getElementById(id)?.textContent || id).trim();

    // -- build the per-figure toolbar -------------------------------------
    for (const figure of MODE === 'project' ? figures() : []) {
      const index = Number(figure.dataset.studioIndex);
      const kind = figure.dataset.studioKind;
      const media = figure.querySelector('img, video');
      if (!media) continue;

      const tools = document.createElement('div');
      tools.className = 'studio-tools';

      const widths = ['full', 'half', 'third'];
      const seg = document.createElement('div');
      seg.className = 'studio-seg';
      seg.setAttribute('role', 'group');
      seg.setAttribute('aria-label', 'Width');
      for (const width of widths) {
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.value = width;
        button.textContent = width[0].toUpperCase() + width.slice(1);
        button.title = `${width} width`;
        button.setAttribute('aria-pressed', String(figure.dataset.studioWidth === width));
        button.addEventListener('click', async () => {
          // Change the page first so the new layout is on screen immediately;
          // the save and HMR reload only confirm it.
          for (const w of widths) figure.classList.toggle(`g-${w}`, w === width);
          figure.dataset.studioWidth = width;
          for (const sibling of seg.querySelectorAll('button')) {
            sibling.setAttribute('aria-pressed', String(sibling.dataset.value === width));
          }
          try {
            await post('/gallery/patch', { index, patch: { width } });
            toast(`width → ${width}`);
          } catch (error) { toast(error.message, true); }
        });
        seg.appendChild(button);
      }
      tools.appendChild(seg);

      // Frame shape. 'auto' is 4:3 for half/third and natural height for full,
      // which is how every existing row already renders — so leaving this
      // alone changes nothing.
      if (kind === 'image') {
        const shapes = [
          ['auto', 'Auto shape'], ['1/1', 'Square'], ['4/3', '4:3'], ['3/2', '3:2'],
          ['16/9', '16:9'], ['3/4', '3:4 tall'], ['2/3', '2:3 tall'], ['9/16', '9:16 tall'],
        ];
        const shape = document.createElement('select');
        shape.title = 'Crop this photo to a fixed shape';
        for (const [value, text] of shapes) shape.appendChild(new Option(text, value));
        shape.value = figure.dataset.studioAspect || 'auto';
        shape.addEventListener('change', async () => {
          const value = shape.value;
          // Reflect it immediately; the reload only confirms.
          figure.classList.toggle('is-framed', value !== 'auto' || !figure.classList.contains('g-full'));
          if (value === 'auto') {
            figure.style.removeProperty('--ratio');
            figure.classList.toggle('is-framed', !figure.classList.contains('g-full'));
          } else {
            figure.style.setProperty('--ratio', value.replace('/', ' / '));
          }
          figure.dataset.studioAspect = value;
          try {
            await post('/gallery/patch', { index, patch: { aspect: value } });
            toast(`shape → ${value === 'auto' ? 'auto' : value}`);
          } catch (error) { toast(error.message, true); }
        });
        tools.appendChild(shape);
      }

      if (HEADINGS.length > 0) {
        const select = document.createElement('select');
        select.title = 'Which section this sits in';
        const bottom = new Option('Bottom of page', '');
        select.appendChild(bottom);
        for (const id of HEADINGS) select.appendChild(new Option(`In ${label(id)}`, id));
        select.value = figure.dataset.studioSection || '';
        select.addEventListener('change', async () => {
          try {
            await post('/gallery/patch', {
              index,
              patch: { section: select.value ? label(select.value) : null },
            });
            toast(select.value ? `moved into ${label(select.value)}` : 'moved to the bottom');
          } catch (error) { toast(error.message, true); }
        });
        tools.appendChild(select);
      }

      tools.appendChild(toolSep());
      const altBtn = toolButton({ icon: 'alt', text: 'Alt', title: 'Edit the description screen readers announce' });
      altBtn.addEventListener('click', () => {
        editAlt(figure, figure.dataset.studioAlt ?? '', async (value) => {
          await post('/gallery/patch', { index, patch: { alt: value } });
          figure.dataset.studioAlt = value;
        });
      });
      tools.appendChild(altBtn);

      const mover = (icon, delta, title) => {
        const button = toolButton({ icon, title });
        button.addEventListener('click', async () => {
          try {
            await post('/gallery/move', { from: index, to: Math.max(0, index + delta) });
            toast('reordered');
          } catch (error) { toast(error.message, true); }
        });
        return button;
      };
      tools.appendChild(mover('left', -1, 'Move earlier'));
      tools.appendChild(mover('right', 1, 'Move later'));

      const remove = toolButton({ icon: 'trash', title: 'Remove from the gallery', className: 'studio-danger' });
      remove.addEventListener('click', async () => {
        if (!confirm('Remove this from the gallery?\n\nIf nothing else uses the file and it was never committed, it is deleted too.')) return;
        try {
          const result = await post('/gallery/delete', { index });
          toast(`removed from the gallery${displacedNote(result.displaced)}`);
        } catch (error) { toast(error.message, true); }
      });
      tools.appendChild(remove);

      figure.appendChild(tools);

      // -- drag to crop ---------------------------------------------------
      if (kind !== 'image') continue;

      const dot = document.createElement('span');
      dot.className = 'studio-crosshair';
      figure.appendChild(dot);

      let [px, py] = toPct(figure.dataset.studioFocal);
      const placeDot = () => {
        const box = media.getBoundingClientRect();
        const frame = figure.getBoundingClientRect();
        dot.style.left = `${box.left - frame.left + (box.width * px) / 100}px`;
        dot.style.top = `${box.top - frame.top + (box.height * py) / 100}px`;
      };
      placeDot();
      window.addEventListener('resize', placeDot);

      let dragging = false;
      let moved = false;

      const apply = (event) => {
        const box = media.getBoundingClientRect();
        px = Math.round(Math.min(100, Math.max(0, ((event.clientX - box.left) / box.width) * 100)));
        py = Math.round(Math.min(100, Math.max(0, ((event.clientY - box.top) / box.height) * 100)));
        figure.style.setProperty('--focal', `${px}% ${py}%`);
        placeDot();
      };

      media.addEventListener('pointerdown', (event) => {
        // An unframed full-width photo fills its own box, so panning it does
        // nothing — until zoom pushes it past the edges.
        if (figure.classList.contains('g-full') && !figure.classList.contains('is-framed')
            && Number(figure.dataset.studioZoom || 1) <= 1) return;
        if (event.button !== 0) return;
        dragging = true;
        moved = false;
        figure.classList.add('is-dragging');
        // Best effort: if the pointer is already gone the drag still works,
        // and throwing here would abort before anything is saved.
        try { media.setPointerCapture(event.pointerId); } catch {}
        event.preventDefault();
      });

      media.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        moved = true;
        apply(event);
      });

      const finish = async (event) => {
        if (!dragging) return;
        dragging = false;
        figure.classList.remove('is-dragging');
        try { media.releasePointerCapture?.(event.pointerId); } catch {}
        if (!moved) return;
        const focal = `${px}% ${py}%`;
        figure.dataset.studioFocal = focal;
        try {
          await post('/gallery/patch', { index, patch: { focal } });
          toast(`crop → ${focal}`);
        } catch (error) { toast(error.message, true); }
      };
      media.addEventListener('pointerup', finish);
      media.addEventListener('pointercancel', finish);

      // -- zoom -----------------------------------------------------------
      // Pinch on a trackpad arrives as a wheel event with ctrlKey set; that
      // and alt+scroll are the two gestures claimed. Plain scrolling is left
      // alone, because hijacking it over every photo would make the page
      // itself hard to read.
      let zoom = Number(figure.dataset.studioZoom || 1) || 1;

      const badge = document.createElement('span');
      badge.className = 'studio-zoom-badge';
      badge.hidden = zoom <= 1;
      badge.textContent = `${zoom.toFixed(2)}x`;
      figure.appendChild(badge);

      const showZoom = () => {
        figure.style.setProperty('--zoom', String(zoom));
        badge.textContent = `${zoom.toFixed(2)}x`;
        badge.hidden = zoom <= 1.001;
        placeDot();
      };

      const saveZoom = () => {
        const value = Number(zoom.toFixed(2));
        figure.dataset.studioZoom = String(value);
        queueSave(`zoom:${index}`, '/gallery/patch', { index, patch: { zoom: value } });
      };

      media.addEventListener('wheel', (event) => {
        if (!event.ctrlKey && !event.altKey) return; // let the page scroll
        event.preventDefault();
        // deltaY is pixels on a trackpad and notches on a mouse; the
        // exponential keeps both feeling proportional rather than one of them
        // jumping the whole range in a flick.
        zoom = Math.min(4, Math.max(1, zoom * Math.exp(-event.deltaY / 400)));
        showZoom();
        saveZoom();
      }, { passive: false });

      // Zooming out to 1 is fiddly with a trackpad, so give it a target.
      badge.addEventListener('click', () => {
        zoom = 1;
        showZoom();
        saveZoom();
        toast('zoom reset');
      });
      badge.title = 'Click to reset zoom';

      // A drag ends in a click, which the lightbox listens for. Swallow it.
      media.addEventListener('click', (event) => {
        if (!moved) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        moved = false;
      }, true);
    }

    // -- project main photo (hero) ----------------------------------------
    //
    // Same gestures as a gallery photo — drag to crop, pinch or ⌥scroll to
    // zoom — plus replace (library or a file dropped straight on it), frame
    // shape and description. Writes top-level frontmatter: hero, heroAlt,
    // heroFocalPoint, heroZoom, heroAspect.
    let heroTarget = false; // true while the library is choosing a new main photo
    const heroWrap = MODE === 'project' ? document.querySelector('[data-studio-hero]') : null;
    const heroFrame = heroWrap?.querySelector('.hero-frame');
    const heroImg = heroFrame?.querySelector('img');

    const HERO_SHAPES = [
      ['wide', 'Wide 21:9', '21 / 9'],
      ['standard', 'Standard 3:2', '3 / 2'],
      ['tall', 'Tall 4:5', '4 / 5'],
      ['square', 'Square', '1 / 1'],
    ];

    const editHeroAlt = (seed) =>
      editAlt(heroFrame, seed ?? heroWrap.dataset.studioAlt ?? '', async (value) => {
        // heroAlt is required by the schema; blank would break the build.
        if (!value) throw new Error('the main photo needs a description');
        await post('/project/patch', { patch: { heroAlt: value } });
        heroWrap.dataset.studioAlt = value;
      });

    if (heroWrap && heroFrame && heroImg) {
      heroFrame.classList.add('studio-slot', 'studio-hero');

      const tools = document.createElement('div');
      tools.className = 'studio-tools';
      tools.appendChild(Object.assign(document.createElement('span'), {
        className: 'studio-tool-label', textContent: 'Main photo',
      }));

      const replace = toolButton({ icon: 'replace', text: 'Replace', title: 'Pick a new main photo from the library — or drop a file on it' });
      replace.addEventListener('click', () => openLibrary({ hero: true }));
      tools.appendChild(replace);

      const shape = document.createElement('select');
      shape.title = 'Shape of the main photo';
      for (const [value, text] of HERO_SHAPES) shape.appendChild(new Option(text, value));
      shape.value = heroWrap.dataset.studioAspect || 'wide';
      shape.addEventListener('change', async () => {
        const ratio = HERO_SHAPES.find(([v]) => v === shape.value)?.[2];
        if (ratio) heroWrap.style.setProperty('--hero-aspect', ratio);
        heroWrap.dataset.studioAspect = shape.value;
        placeDot();
        try {
          await post('/project/patch', { patch: { heroAspect: shape.value } });
          toast(`main photo → ${shape.selectedOptions[0].text}`);
        } catch (error) { toast(error.message, true); }
      });
      tools.appendChild(shape);

      tools.appendChild(toolSep());
      const altBtn = toolButton({ icon: 'alt', text: 'Alt', title: 'Edit the description screen readers announce' });
      altBtn.addEventListener('click', () => editHeroAlt());
      tools.appendChild(altBtn);
      heroFrame.appendChild(tools);

      // Drop a file on the main photo to replace it. Stops propagation so the
      // page-wide handler doesn't also add it to the gallery.
      heroFrame.addEventListener('dragover', (event) => {
        if (!isFileDrag(event)) return;
        event.preventDefault();
        event.stopPropagation();
        heroFrame.classList.add('studio-slot-over');
      });
      heroFrame.addEventListener('dragleave', () => heroFrame.classList.remove('studio-slot-over'));
      heroFrame.addEventListener('drop', async (event) => {
        if (!isFileDrag(event)) return;
        event.preventDefault();
        event.stopPropagation();
        heroFrame.classList.remove('studio-slot-over');
        dropEl.hidden = true;
        const file = event.dataTransfer.files[0];
        if (!file) return;
        toast(`replacing the main photo with ${file.name}…`);
        try {
          const data = await readAsBase64(file);
          const result = await post('/project/hero', { filename: file.name, data });
          toast(`main photo → ${file.name}  ${size(result.before)} → ${size(result.after)}${displacedNote(result.displaced)}`);
          parkAltPrompt({ hero: true, staleAlt: result.staleAlt });
        } catch (error) { toast(error.message, true); }
      });

      // Crop and zoom.
      const dot = document.createElement('span');
      dot.className = 'studio-crosshair';
      heroFrame.appendChild(dot);

      let [px, py] = toPct(heroWrap.dataset.studioFocal);
      let zoom = Number(heroWrap.dataset.studioZoom || 1) || 1;

      const badge = document.createElement('span');
      badge.className = 'studio-zoom-badge';
      badge.title = 'Click to reset zoom';
      heroFrame.appendChild(badge);

      function placeDot() {
        const box = heroImg.getBoundingClientRect();
        const frame = heroFrame.getBoundingClientRect();
        dot.style.left = `${box.left - frame.left + (box.width * px) / 100}px`;
        dot.style.top = `${box.top - frame.top + (box.height * py) / 100}px`;
      }
      const showHero = () => {
        heroWrap.style.setProperty('--hero-focal', `${px}% ${py}%`);
        heroWrap.style.setProperty('--hero-zoom', String(zoom));
        badge.textContent = `${zoom.toFixed(2)}×`;
        badge.hidden = zoom <= 1.001;
        placeDot();
      };
      showHero();
      window.addEventListener('resize', placeDot);
      heroImg.addEventListener('load', placeDot);

      let dragging = false;
      let moved = false;
      heroImg.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        dragging = true;
        moved = false;
        heroFrame.classList.add('is-dragging');
        try { heroImg.setPointerCapture(event.pointerId); } catch {}
        event.preventDefault();
      });
      heroImg.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        moved = true;
        const box = heroImg.getBoundingClientRect();
        px = Math.round(Math.min(100, Math.max(0, ((event.clientX - box.left) / box.width) * 100)));
        py = Math.round(Math.min(100, Math.max(0, ((event.clientY - box.top) / box.height) * 100)));
        showHero();
      });
      const finish = async (event) => {
        if (!dragging) return;
        dragging = false;
        heroFrame.classList.remove('is-dragging');
        try { heroImg.releasePointerCapture?.(event.pointerId); } catch {}
        if (!moved) return;
        const focal = `${px}% ${py}%`;
        heroWrap.dataset.studioFocal = focal;
        try {
          await post('/project/patch', { patch: { heroFocalPoint: focal } });
          toast(`main photo crop → ${focal}`);
        } catch (error) { toast(error.message, true); }
      };
      heroImg.addEventListener('pointerup', finish);
      heroImg.addEventListener('pointercancel', finish);

      const saveZoom = () => {
        const value = Number(zoom.toFixed(2));
        heroWrap.dataset.studioZoom = String(value);
        queueSave('zoom:hero', '/project/patch', { patch: { heroZoom: value } });
      };
      heroImg.addEventListener('wheel', (event) => {
        if (!event.ctrlKey && !event.altKey) return; // let the page scroll
        event.preventDefault();
        zoom = Math.min(4, Math.max(1, zoom * Math.exp(-event.deltaY / 400)));
        showHero();
        saveZoom();
      }, { passive: false });
      badge.addEventListener('click', () => {
        zoom = 1;
        showHero();
        saveZoom();
        toast('zoom reset');
      });

      // A replace on the previous load asked for a new description.
      const pendingAlt = takeAltPrompt();
      if (pendingAlt?.hero) {
        heroFrame.scrollIntoView({ block: 'center', behavior: 'smooth' });
        toast('Main photo replaced — update the description');
        editHeroAlt(pendingAlt.staleAlt);
      }
    }

    // -- walkthrough figures: drag callout markers -------------------------
    //
    // Marker positions are percentages of the frame, so dragging writes
    // exactly what the page renders. Drag to move, ⌥-click to delete, and
    // "+ Marker" drops a new one in the middle. Labels and points are text;
    // edit those in Pages CMS.
    for (const fig of MODE === 'project' ? document.querySelectorAll('figure[data-studio-figure]') : []) {
      const figIndex = Number(fig.dataset.studioFigure);
      const frame = fig.querySelector('.pfig-frame');
      if (!frame || !frame.querySelector('img')) continue; // placeholders, comparisons, video: no markers

      frame.classList.add('studio-slot', 'studio-figure-frame');
      const tools = document.createElement('div');
      tools.className = 'studio-tools';
      tools.appendChild(Object.assign(document.createElement('span'), {
        className: 'studio-tool-label', textContent: `Fig. ${figIndex + 1}`,
      }));
      const add = toolButton({ icon: 'plus', text: 'Marker', title: 'Add a callout marker in the middle of the photo' });
      add.addEventListener('click', async () => {
        try {
          await post('/figure/callout', { figure: figIndex, add: true, x: 50, y: 50 });
          toast('marker added — drag it into place');
        } catch (error) { toast(error.message, true); }
      });
      tools.appendChild(add);
      tools.appendChild(Object.assign(document.createElement('span'), {
        className: 'studio-tool-hint', textContent: 'drag markers · ⌥-click to delete',
      }));
      frame.appendChild(tools);

      for (const marker of frame.querySelectorAll('[data-studio-callout]')) {
        const n = Number(marker.dataset.studioCallout);
        let dragging = false;
        let moved = false;
        let x = parseFloat(marker.style.getPropertyValue('--cx')) || 50;
        let y = parseFloat(marker.style.getPropertyValue('--cy')) || 50;

        marker.addEventListener('pointerdown', async (event) => {
          if (event.button !== 0) return;
          event.preventDefault();
          event.stopPropagation();
          if (event.altKey) {
            if (!confirm(`Delete marker ${n}? The point with the same number stays; remove it in Pages CMS.`)) return;
            try {
              await post('/figure/callout', { figure: figIndex, callout: n, remove: true });
              toast(`marker ${n} deleted`);
            } catch (error) { toast(error.message, true); }
            return;
          }
          dragging = true;
          moved = false;
          marker.classList.add('is-dragging');
          try { marker.setPointerCapture(event.pointerId); } catch {}
        });
        marker.addEventListener('pointermove', (event) => {
          if (!dragging) return;
          moved = true;
          const box = frame.getBoundingClientRect();
          x = Math.round(Math.min(100, Math.max(0, ((event.clientX - box.left) / box.width) * 100)) * 10) / 10;
          y = Math.round(Math.min(100, Math.max(0, ((event.clientY - box.top) / box.height) * 100)) * 10) / 10;
          marker.style.setProperty('--cx', `${x}%`);
          marker.style.setProperty('--cy', `${y}%`);
        });
        const finish = async (event) => {
          if (!dragging) return;
          dragging = false;
          marker.classList.remove('is-dragging');
          try { marker.releasePointerCapture?.(event.pointerId); } catch {}
          if (!moved) return;
          try {
            await post('/figure/callout', { figure: figIndex, callout: n, x, y });
            toast(`marker ${n} → ${x}%, ${y}%`);
          } catch (error) { toast(error.message, true); }
        };
        marker.addEventListener('pointerup', finish);
        marker.addEventListener('pointercancel', finish);
        // The page's own click handler scrolls to the matching point; a drag
        // ends in a click, so swallow that one.
        marker.addEventListener('click', (event) => {
          if (!moved) return;
          event.preventDefault();
          event.stopImmediatePropagation();
          moved = false;
        }, true);
      }
    }

    // -- home page: per-slot controls --------------------------------------
    let homeTarget = null; // which slot the library panel will fill

    for (const slot of MODE === 'home' ? homeSlots() : []) {
      const { el, path } = slot;
      const media = el.querySelector('img, video');
      el.classList.add('studio-slot');

      const tools = document.createElement('div');
      tools.className = 'studio-tools';

      const replace = toolButton({ icon: 'replace', text: 'Replace', title: `Pick a new photo for ${path}` });
      replace.addEventListener('click', () => {
        homeTarget = path;
        openLibrary();
      });
      tools.appendChild(replace);

      // Experience logos have no alt field — index.astro uses the org name as
      // the description — so offering the button there would only ever error.
      const hasAlt = !path.endsWith('.logo');

      const altBtn = toolButton({ icon: 'alt', text: 'Alt', title: 'Edit the description screen readers announce' });
      const openAlt = async (seed) => {
        let current = seed;
        if (current === undefined) {
          try {
            current = (await post('/home/alt', { imagePath: path })).value;
          } catch (error) { toast(error.message, true); return; }
        }
        editAlt(el, current, (value) => post('/home/alt', { imagePath: path, value }));
      };
      altBtn.addEventListener('click', () => openAlt());
      if (hasAlt) tools.appendChild(altBtn);

      /**
       * List controls, for slots that are a row in a home.json array
       * ("showcase.items.2.image"). Fixed slots like hero.headshot aren't in a
       * list, so reordering and removing them would be meaningless.
       */
      const row = path.match(/^(.*\.items)\.(\d+)\./);
      if (row) {
        const [, listPath, rawIndex] = row;
        const index = Number(rawIndex);
        el.dataset.studioList = listPath;
        el.dataset.studioRow = String(index);

        /**
         * Drag to rearrange.
         *
         * From a grip rather than the tile body: a pointerdown on the photo
         * already starts a crop, and one gesture can't mean two things. The
         * drop target is whatever tile is under the pointer, so this reorders
         * on the grid rather than positioning freely — which is what keeps it
         * working at phone width, where the grid reflows to one column.
         */
        const move = async (to, note) => {
          try {
            await post('/home/move', { listPath, from: index, to });
            toast(note);
          } catch (error) { toast(error.message, true); }
        };

        const grip = toolButton({ icon: 'grip', title: 'Drag to rearrange', className: 'studio-grip' });
        grip.addEventListener('pointerdown', (event) => {
          if (event.button !== 0) return;
          event.preventDefault();
          event.stopPropagation();
          try { grip.setPointerCapture(event.pointerId); } catch {}
          document.body.classList.add('studio-rearranging');
          el.classList.add('studio-dragging-tile');

          let target = null;
          const onMove = (moveEvent) => {
            const under = document
              .elementFromPoint(moveEvent.clientX, moveEvent.clientY)
              ?.closest('[data-studio-row]');
            if (target === under) return;
            target?.classList.remove('studio-drop-target');
            target = under && under !== el && under.dataset.studioList === listPath ? under : null;
            target?.classList.add('studio-drop-target');
          };

          const onUp = async () => {
            grip.removeEventListener('pointermove', onMove);
            grip.removeEventListener('pointerup', onUp);
            grip.removeEventListener('pointercancel', onUp);
            document.body.classList.remove('studio-rearranging');
            el.classList.remove('studio-dragging-tile');
            target?.classList.remove('studio-drop-target');
            if (!target) return;
            await move(Number(target.dataset.studioRow), 'rearranged');
          };

          grip.addEventListener('pointermove', onMove);
          grip.addEventListener('pointerup', onUp);
          grip.addEventListener('pointercancel', onUp);
        });
        tools.appendChild(grip);

        for (const [icon, delta, title] of [['left', -1, 'Move earlier'], ['right', 1, 'Move later']]) {
          const button = toolButton({ icon, title });
          button.addEventListener('click', () => move(Math.max(0, index + delta), 'reordered'));
          tools.appendChild(button);
        }

        // Which cell this takes in the collage. Only the showcase has the
        // dominant large/video cells; the other lists are uniform.
        if (listPath === 'showcase.items') {
          const sizes = [['regular', 'Small cell'], ['large', 'Big cell'], ['video', 'Tall cell']];
          const size = document.createElement('select');
          size.title = 'How much of the collage this fills';
          for (const [value, text] of sizes) size.appendChild(new Option(text, value));
          size.value = el.classList.contains('collage-large')
            ? 'large'
            : el.classList.contains('collage-video') ? 'video' : 'regular';
          size.addEventListener('change', async () => {
            try {
              await post('/home/patch', { path: `${listPath}.${index}.size`, value: size.value });
              toast(`cell → ${size.value}`);
            } catch (error) { toast(error.message, true); }
          });
          tools.appendChild(size);
        }

        const add = toolButton({ icon: 'plus', title: 'Add an empty tile after this one' });
        add.addEventListener('click', async () => {
          try {
            await post('/home/add', { listPath, after: index });
            toast('tile added — drop a photo on it');
          } catch (error) { toast(error.message, true); }
        });
        tools.appendChild(add);

        const remove = toolButton({ icon: 'trash', title: 'Remove this tile', className: 'studio-danger' });
        remove.addEventListener('click', async () => {
          if (!confirm('Remove this tile?\n\nIf nothing else uses the file and it was never committed, it is moved to .photo-trash and ⌘Z brings it back.')) return;
          try {
            const result = await post('/home/remove', { listPath, index });
            toast(result.displaced?.deleted ? `removed · ${result.displaced.file} trashed` : 'removed');
          } catch (error) { toast(error.message, true); }
        });
        tools.appendChild(remove);
      }

      const name = document.createElement('span');
      name.className = 'studio-slot-path';
      name.textContent = path.replace(/Section|\.items/g, '');
      tools.appendChild(name);

      el.appendChild(tools);

      // Drop a file directly on the photo it should replace.
      el.addEventListener('dragover', (event) => {
        if (!isFileDrag(event)) return;
        event.preventDefault();
        event.stopPropagation();
        el.classList.add('studio-slot-over');
      });
      el.addEventListener('dragleave', () => el.classList.remove('studio-slot-over'));
      el.addEventListener('drop', async (event) => {
        if (!isFileDrag(event)) return;
        event.preventDefault();
        event.stopPropagation(); // don't also fire the page-wide handler
        el.classList.remove('studio-slot-over');
        const file = event.dataTransfer.files[0];
        if (!file) return;
        toast(`replacing ${path}…`);
        try {
          const data = await readAsBase64(file);
          const result = await post('/home/upload', { path, filename: file.name, data });
          toast(
            (result.kind === 'image'
              ? `${path} → ${file.name}  ${size(result.before)} → ${size(result.after)}`
              : `${path} → ${result.file}`) + displacedNote(result.displaced),
          );
          // The description still describes the photo that just left. The
          // reload is about to land, so hand the prompt to the next page load.
          if (result.altPath) parkAltPrompt({ path, staleAlt: result.staleAlt });
        } catch (error) {
          toast(error.message, true);
        }
      });

      // Drag to crop, for the one slot whose schema has a focal point.
      // Every image slot is croppable now. The focal and zoom field names
      // differ per section (aboutSection has photoFocalPoint, list rows take a
      // sibling focal), so the server resolves them from the slot path rather
      // than the client carrying a second copy of that table.
      if (media.tagName !== 'IMG') continue;

      const dot = document.createElement('span');
      dot.className = 'studio-crosshair';
      el.appendChild(dot);

      const current = getComputedStyle(media).objectPosition;
      let [px, py] = (() => {
        const m = current.match(/(-?[\d.]+)%\s+(-?[\d.]+)%/);
        return m ? [parseFloat(m[1]), parseFloat(m[2])] : [50, 50];
      })();

      const readZoom = () => {
        const v = parseFloat(getComputedStyle(el).getPropertyValue('--zoom'));
        return Number.isFinite(v) && v >= 1 ? v : 1;
      };
      let zoom = readZoom();

      const badge = document.createElement('span');
      badge.className = 'studio-zoom-badge';
      badge.hidden = zoom <= 1.001;
      badge.textContent = `${zoom.toFixed(2)}x`;
      badge.title = 'Click to reset zoom';
      el.appendChild(badge);

      const placeDot = () => {
        const box = media.getBoundingClientRect();
        const frame = el.getBoundingClientRect();
        dot.style.left = `${box.left - frame.left + (box.width * px) / 100}px`;
        dot.style.top = `${box.top - frame.top + (box.height * py) / 100}px`;
      };
      placeDot();
      window.addEventListener('resize', placeDot);

      /**
       * Preview locally.
       *
       * Both the custom property and the inline style are set: the collage
       * reads --focal, the about photo reads its own --about-focal, and the
       * inline objectPosition covers whatever a slot's CSS happens to use.
       * The reload after the save is what makes it real either way.
       */
      const showHome = () => {
        const focal = `${px}% ${py}%`;
        el.style.setProperty('--focal', focal);
        el.style.setProperty('--zoom', String(zoom));
        media.style.objectPosition = focal;
        media.style.transformOrigin = focal;
        media.style.transform = `scale(${zoom})`;
        badge.textContent = `${zoom.toFixed(2)}x`;
        badge.hidden = zoom <= 1.001;
        placeDot();
      };

      let dragging = false;
      let moved = false;
      media.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        dragging = true;
        moved = false;
        el.classList.add('is-dragging');
        // Best effort: if the pointer is already gone the drag still works,
        // and throwing here would abort before anything is saved.
        try { media.setPointerCapture(event.pointerId); } catch {}
        event.preventDefault();
      });
      media.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        moved = true;
        const box = media.getBoundingClientRect();
        px = Math.round(Math.min(100, Math.max(0, ((event.clientX - box.left) / box.width) * 100)));
        py = Math.round(Math.min(100, Math.max(0, ((event.clientY - box.top) / box.height) * 100)));
        showHome();
      });
      const finishHome = async (event) => {
        if (!dragging) return;
        dragging = false;
        el.classList.remove('is-dragging');
        try { media.releasePointerCapture?.(event.pointerId); } catch {}
        if (!moved) return;
        try {
          await post('/home/crop', { imagePath: path, focal: `${px}% ${py}%` });
          toast(`crop → ${px}% ${py}%`);
        } catch (error) {
          toast(error.message, true);
        }
      };
      media.addEventListener('pointerup', finishHome);
      media.addEventListener('pointercancel', finishHome);

      // Same gesture as the project gallery: pinch, or ⌥scroll.
      const saveHomeZoom = () =>
        queueSave(`zoom:${path}`, '/home/crop', { imagePath: path, zoom: Number(zoom.toFixed(2)) });
      media.addEventListener('wheel', (event) => {
        if (!event.ctrlKey && !event.altKey) return;
        event.preventDefault();
        zoom = Math.min(4, Math.max(1, zoom * Math.exp(-event.deltaY / 400)));
        showHome();
        saveHomeZoom();
      }, { passive: false });
      badge.addEventListener('click', () => {
        zoom = 1;
        showHome();
        saveHomeZoom();
        toast('zoom reset');
      });
    }

    // A replace on the previous page load asked for a new description.
    if (MODE === 'home') {
      const pending = takeAltPrompt();
      if (pending) {
        const slot = homeSlots().find((x) => x.path === pending.path);
        if (slot?.el) {
          slot.el.scrollIntoView({ block: 'center', behavior: 'smooth' });
          toast('Photo replaced — update the description');
          editAlt(slot.el, pending.staleAlt, (value) =>
            post('/home/alt', { imagePath: pending.path, value }),
          );
        }
      }
    }

    // -- library panel ----------------------------------------------------
    // Browse portfolio-photos/ without leaving the page. Picking copies the
    // file through the same pipeline as a drag-and-drop; the library itself is
    // never written to.
    const libPanel = root.querySelector('.studio-library');
    const libFolders = root.querySelector('.studio-lib-folders');
    const libGrid = root.querySelector('.studio-lib-grid');
    const libSection = root.querySelector('.studio-lib-section');
    const libWidth = root.querySelector('.studio-lib-width');

    if (MODE === 'home') {
      // Fixed slots: there's no section to choose or width to set.
      for (const el of root.querySelectorAll('.studio-library header label')) el.hidden = true;
    } else {
      libSection.appendChild(new Option('Bottom of page', ''));
      for (const id of HEADINGS) libSection.appendChild(new Option(label(id), id));
    }

    let libraryData = null;
    let activeKey = null;
    const keyOf = (group) => `${group.source}::${group.folder}`;

    const SOURCE_LABEL = {
      inbox: 'Photo inbox',
      library: 'On this Mac',
      site: 'Already on the site',
      videos: 'Already on the site',
    };

    const renderGrid = () => {
      const group = libraryData?.groups.find((g) => keyOf(g) === activeKey);
      libGrid.replaceChildren();
      if (!group) return;

      for (const file of group.files) {
        const tile = document.createElement('button');
        tile.type = 'button';
        tile.className = 'studio-lib-tile';

        const img = document.createElement('img');
        img.loading = 'lazy';
        img.alt = '';
        // Inbox groups are sorted by prefix, not folder, so each file carries
        // its own folder; everything else shares the group's.
        const folder = file.folder ?? group.folder;
        img.src =
          `${API}/library/thumb?source=${encodeURIComponent(group.source)}` +
          `&folder=${encodeURIComponent(folder)}` +
          `&file=${encodeURIComponent(file.name)}`;
        // Videos and anything sharp can't read still get a tile, just no preview.
        img.addEventListener('error', () => { img.style.visibility = 'hidden'; });
        tile.appendChild(img);

        if (file.kind === 'video') {
          const kind = document.createElement('span');
          kind.className = 'badge kind';
          kind.textContent = 'Video';
          tile.appendChild(kind);
        }
        if (file.used) {
          const used = document.createElement('span');
          used.className = 'badge';
          used.textContent = group.source === 'library' || group.source === 'inbox' ? 'Added' : 'On this page';
          tile.appendChild(used);
        }

        const meta = document.createElement('span');
        meta.className = 'meta';
        meta.innerHTML = '<b></b>';
        meta.querySelector('b').textContent = file.name;
        meta.append(size(file.size));
        tile.appendChild(meta);

        tile.addEventListener('click', async () => {
          if (MODE === 'home' && !homeTarget) {
            toast('Hover the photo you want to change and choose Replace', true);
            return;
          }
          tile.disabled = true;
          const sectionId = libSection.value;
          try {
            const result = await post('/library/pick', {
              source: group.source,
              folder,
              file: file.name,
              section: sectionId ? label(sectionId) : null,
              width: libWidth.value || null,
              homePath: MODE === 'home' ? homeTarget : null,
              hero: heroTarget,
            });
            toast(
              result.hero
                ? `main photo → ${file.name}${displacedNote(result.displaced)}`
                : result.home
                ? `${homeTarget} → ${file.name}${displacedNote(result.displaced)}`
                : result.reused
                  ? `added ${file.name} (already in the repo — not copied)`
                  : result.kind === 'image'
                    ? `${file.name}  ${size(result.before)} → ${size(result.after)}`
                    : `${file.name} → ${result.file}`,
            );
            if (MODE === 'home') {
              libPanel.hidden = true;
              if (result.altPath) parkAltPrompt({ path: homeTarget, staleAlt: result.staleAlt });
            }
            if (result.hero) {
              libPanel.hidden = true;
              parkAltPrompt({ hero: true, staleAlt: result.staleAlt });
            }
          } catch (error) {
            toast(error.message, true);
            tile.disabled = false;
          }
        });

        libGrid.appendChild(tile);
      }
    };

    const libTarget = root.querySelector('.studio-lib-target');
    const openLibrary = async ({ hero = false } = {}) => {
      heroTarget = MODE === 'project' && hero;
      libPanel.classList.toggle('is-hero', heroTarget);
      for (const el of root.querySelectorAll('.studio-lib-opt')) el.hidden = MODE === 'home' || heroTarget;
      libTarget.textContent = heroTarget
        ? 'Choosing a new main photo for this project'
        : MODE === 'home'
          ? (homeTarget ? `Replacing ${homeTarget}` : 'Hover a photo on the page and choose Replace')
          : 'Pick a file to add it to this page';
      libPanel.hidden = false;
      libGrid.replaceChildren(
        Object.assign(document.createElement('p'), {
          className: 'studio-lib-empty',
          textContent: 'Reading portfolio-photos/…',
        }),
      );
      try {
        const response = await fetch(`${API}/library?slug=${encodeURIComponent(slug)}`);
        libraryData = await response.json();
      } catch {
        libGrid.replaceChildren(
          Object.assign(document.createElement('p'), {
            className: 'studio-lib-empty',
            textContent: 'Could not read the library — is npm run studio still running?',
          }),
        );
        return;
      }

      libFolders.replaceChildren();
      if (!libraryData.groups?.length) {
        libGrid.replaceChildren(
          Object.assign(document.createElement('p'), {
            className: 'studio-lib-empty',
            textContent: 'No media found.',
          }),
        );
        return;
      }

      // Group the sidebar by source so "on this Mac" and "already on the site"
      // read as two different things rather than one long folder list.
      let lastHeading = null;
      for (const group of libraryData.groups) {
        const heading = SOURCE_LABEL[group.source];
        if (heading !== lastHeading) {
          const h = document.createElement('p');
          h.className = 'studio-lib-heading';
          h.textContent = heading;
          libFolders.appendChild(h);
          lastHeading = heading;
        }

        const button = document.createElement('button');
        button.type = 'button';
        const name = document.createElement('span');
        name.textContent = group.label;
        const count = document.createElement('span');
        count.className = 'count';
        count.textContent = String(group.files.length);
        button.append(name, count);
        if (group.current) button.dataset.current = '';
        if (group.source === 'library') button.dataset.library = '';
        button.addEventListener('click', () => {
          activeKey = keyOf(group);
          for (const sibling of libFolders.querySelectorAll('button')) {
            sibling.setAttribute('aria-current', String(sibling === button));
          }
          renderGrid();
        });
        libFolders.appendChild(button);
      }
      // How to get new photos in. Shown every time because the scheme is the
      // kind of thing you forget between editing sessions.
      const note = document.createElement('p');
      note.className = 'studio-lib-note';
      note.innerHTML =
        'New photos: drop them in <code>photo-inbox/</code> named <code>PREFIX_title</code> — ' +
        'e.g. <code>ABV_valve-test.jpg</code>. Prefixes live in <code>photo-prefixes.json</code>. ' +
        'Reopen this panel to see them.';
      libFolders.appendChild(note);

      // Open on this project's inbox if it has anything, else the first
      // archive folder — the old default.
      (libFolders.querySelector('button[data-current]')
        || libFolders.querySelector('button[data-library]')
        || libFolders.querySelector('button'))?.click();
    };

    root.querySelector('.studio-library-open').addEventListener('click', () => {
      // From the bar there's no slot chosen; a stale one from an earlier
      // Replace would silently overwrite the wrong photo.
      homeTarget = null;
      openLibrary();
    });
    root.querySelector('.studio-lib-close').addEventListener('click', () => { libPanel.hidden = true; });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !libPanel.hidden) libPanel.hidden = true;

      // ⌘Z is the browser's own undo inside a text field; only claim it when
      // the caret isn't in one, or editing a caption would become impossible.
      const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement?.tagName ?? '')
        || document.activeElement?.isContentEditable;
      if (!typing && (event.metaKey || event.ctrlKey) && !event.shiftKey && event.key.toLowerCase() === 'z') {
        event.preventDefault();
        doUndo();
      }
    });

    // -- drop files anywhere on the page ----------------------------------
    let dragDepth = 0;

    window.addEventListener('dragenter', (event) => {
      if (!isFileDrag(event)) return;
      dragDepth += 1;
      dropEl.hidden = false;
    });
    window.addEventListener('dragover', (event) => { if (isFileDrag(event)) event.preventDefault(); });
    window.addEventListener('dragleave', () => {
      dragDepth = Math.max(0, dragDepth - 1);
      if (dragDepth === 0) dropEl.hidden = true;
    });

    window.addEventListener('drop', async (event) => {
      if (!isFileDrag(event)) return;
      event.preventDefault();
      dragDepth = 0;
      dropEl.hidden = true;

      const files = [...event.dataTransfer.files];
      if (files.length === 0) return;

      // Home slots are fixed, so a loose drop has no destination. The per-slot
      // handlers stop propagation, so reaching here means it missed a photo.
      if (MODE === 'home') {
        toast('Drop it directly onto the photo you want to replace', true);
        return;
      }

      // Which section was it dropped into? Nearest heading above the cursor.
      let section = null;
      const target = document.elementFromPoint(event.clientX, event.clientY);
      const heading = target?.closest('.project-body')
        ? [...document.querySelectorAll('.project-body h2')]
            .filter((h) => h.getBoundingClientRect().top <= event.clientY)
            .pop()
        : null;
      if (heading) section = heading.textContent.trim();

      let done = 0;
      for (const file of files) {
        toast(`uploading ${file.name} (${done + 1}/${files.length})…`);
        try {
          const data = await readAsBase64(file);
          const result = await post('/upload', { filename: file.name, data, section });
          done += 1;
          const where = section ? `, in ${section}` : '';
          toast(
            result.kind === 'image'
              ? `${file.name}  ${size(result.before)} → ${size(result.after)}${where}`
              : `${file.name} → ${result.file}${where}`,
          );
        } catch (error) {
          toast(`${file.name}: ${error.message}`, true);
          return;
        }
      }
      if (done > 1) toast(`added ${done} files`);
    });
  }
</script>
)}
