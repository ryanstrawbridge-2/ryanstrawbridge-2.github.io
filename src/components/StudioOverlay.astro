  /* --- per-figure editing ------------------------------------------------ */

  figure[data-studio-index] { position: relative; }

  figure[data-studio-index]:hover > img,
  figure[data-studio-index]:hover > video {
    outline: 2px solid rgb(37 99 235 / 0.9);
    outline-offset: 2px;
  }

  figure[data-studio-index][data-studio-kind='image'] > img { cursor: grab; }
  figure[data-studio-index].is-dragging > img { cursor: grabbing; }
  /* The lightbox binds click on any img in the root; suppress it mid-drag. */
  figure[data-studio-index].is-dragging { pointer-events: auto; }

  .studio-tools {
