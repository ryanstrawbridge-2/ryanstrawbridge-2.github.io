  .studio-slot:hover .studio-crosshair,
  .studio-slot.is-dragging .studio-crosshair { opacity: 1; }
  figure.g-full .studio-crosshair { display: none; }

  /* --- hover outlines ---------------------------------------------------- */

  .studio-slot { position: relative; }
  .studio-slot:hover img,
  .studio-slot:hover video,
  figure[data-studio-index]:hover > .gallery-frame {
    outline: 2px solid rgb(59 130 246 / 0.9);
