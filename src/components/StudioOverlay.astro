---
/**
 * Live editor overlay. Renders ONLY in `astro dev`, so nothing here reaches the
 * deployed site — the production build emits an empty string.
 *
 * Pairs with scripts/studio-server.mjs: this is the UI, that is the writer.
 * Every control changes the page immediately and saves in the background, so
 * you see the real crop while you drag it instead of after a save-and-look.
 */
interface Props {
  /** Heading ids on this page, for the "move to section" menu. */
  headings?: string[];
  /** 'project' edits a gallery list; 'home' edits fixed slots in home.json. */
  mode?: 'project' | 'home';
}
const { headings = [], mode = 'project' } = Astro.props;
const enabled = import.meta.env.DEV;
const studioPort = Number(import.meta.env.STUDIO_PORT ?? 4322);
---

{
  enabled && (
    <div
      id="studio"
      data-port={studioPort}
      data-mode={mode}
      data-headings={JSON.stringify(headings)}
      hidden
    >
      <div class="studio-bar">
        <span class="studio-dot" />
        <strong>Studio</strong>
        <span class="studio-hint">{mode === 'home' ? 'drag to crop · pinch or ⌥scroll to zoom · hover to replace' : 'drag to crop · pinch or ⌥scroll to zoom · drop files anywhere'}</span>
        <button type="button" class="studio-phone" title="See this page at phone width">phone</button>
        <button type="button" class="studio-publish" title="Commit and push to the live site">publish</button>
        <button type="button" class="studio-undo" title="Undo the last edit (⌘Z)" disabled>undo</button>
        <button type="button" class="studio-library-open">library</button>
        <button type="button" class="studio-off" title="Hide until reload">hide</button>
      </div>
      <div class="studio-toast" hidden />

      <div class="studio-phone-panel" hidden>
        <header>
          <strong>Phone</strong>
          <select class="studio-phone-size">
            <option value="390x844">iPhone 15 · 390</option>
            <option value="375x812">iPhone SE/13 mini · 375</option>
            <option value="430x932">iPhone Pro Max · 430</option>
            <option value="768x1024">iPad · 768</option>
          </select>
          <button type="button" class="studio-phone-reload" title="Reload the preview">↻</button>
          <button type="button" class="studio-phone-close">close</button>
        </header>
        <iframe class="studio-phone-frame" title="Phone preview" />
      </div>

      <div class="studio-publish-panel" hidden>
        <header>
          <strong>Publish to the live site</strong>
          <button type="button" class="studio-pub-close">close</button>
        </header>
        <label class="studio-pub-msg">
          What changed?
          <input type="text" placeholder="Content update" />
        </label>
        <div class="studio-pub-log" hidden />
        <footer>
          <span class="studio-pub-state">This commits and pushes everything saved. It goes live in about two minutes.</span>
          <button type="button" class="studio-pub-go">publish</button>
        </footer>
      </div>
      <div class="studio-drop" hidden><span>Drop to add to this project</span></div>

      <div class="studio-library" hidden>
        <header>
          <strong>Photos &amp; video</strong>
          <span class="studio-lib-path">portfolio-photos/ + what is already on the site</span>
          <label>into <select class="studio-lib-section"></select></label>
          <label>as <select class="studio-lib-width">
            <option value="">page default</option>
            <option value="full">full</option>
            <option value="half">half</option>
            <option value="third">third</option>
          </select></label>
          <button type="button" class="studio-lib-close">close</button>
        </header>
        <div class="studio-lib-body">
          <nav class="studio-lib-folders" />
          <div class="studio-lib-grid" />
        </div>
      </div>
    </div>
  )
}

{enabled && (
<style is:global is:inline>
  #studio[hidden] { display: none; }

