  figure[data-studio-index].is-dragging { pointer-events: auto; }

  /* --- walkthrough figure markers -------------------------------------- */

  .studio-figure-frame [data-studio-callout] { cursor: grab; touch-action: none; }
  .studio-figure-frame [data-studio-callout].is-dragging { cursor: grabbing; z-index: 6; }
  .studio-figure-frame [data-studio-callout].is-dragging .pfig-callout-dot {
