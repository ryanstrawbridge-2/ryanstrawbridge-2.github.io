  .studio-slot-over { outline: 2px dashed var(--st-accent); outline-offset: 4px; background: rgb(59 130 246 / 0.06); }
  .studio-slot[data-tina-field*='photo'] img,
  .studio-hero img { cursor: grab; }
  .studio-slot.is-dragging img { cursor: grabbing; }
  /* The main photo's frame clips its own outline, so draw it inside. */
  .studio-hero:hover img { outline: none; }
