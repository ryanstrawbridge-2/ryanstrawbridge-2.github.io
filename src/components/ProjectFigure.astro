---
/**
 * One walkthrough figure: headline, picture, numbered points, pinned callouts.
 *
 * Reads like a presentation slide as you scroll — a claim, the evidence for it,
 * and labels on the part of the picture each point is about.
 *
 * Two decisions worth knowing:
 *
 * 1. Callout positions are PERCENTAGES of the frame, not pixels. A pixel
 *    offset breaks the moment the image is resized, re-cropped or viewed on a
 *    phone; a percentage survives all three.
 * 2. The marker carries a number and (on wide screens) a short label. The
 *    actual explanation lives in `points`, as real text in an ordered list —
 *    so it is selectable, translatable, and readable by a screen reader that
 *    will never see where a marker sits. The two are linked by number.
 */
import { Image } from 'astro:assets';
import Model3D from './Model3D.astro';
import { videoSrc } from '../lib/gallery';
import { KIND_LABEL, type Figure } from '../lib/figures';

interface Props {
  figure: Figure;
  /** Builds the data-tina-field path, e.g. (i, key) => f('figures', i, key) */
  field?: (index: number, key: string) => string | undefined;
}

const { figure, field } = Astro.props;
const {
  index,
  number,
  kind,
  title,
  takeaway,
  image,
  compare,
  beforeLabel,
  afterLabel,
  video,
  model,
  poster,
  alt,
  caption,
  plan,
  frameStyle,
  ratio,
  points,
  callouts,
  placeholder,
} = figure;

// Dev-only hooks for the live editor, same contract as GalleryGrid.
const studio = import.meta.env.DEV;
const hasAside = points.length > 0;
---

<figure
  class:list={['pfig', `pfig-${kind}`, placeholder && 'is-placeholder', hasAside && 'has-aside']}
  data-figure={String(number)}
  data-tina-field={field?.(index, placeholder ? 'title' : video ? 'video' : 'image')}
  {...studio && {
    'data-studio-figure': String(index),
    'data-studio-kind': kind,
  }}
>
  {
    takeaway && (
      <p class="pfig-takeaway" data-tina-field={field?.(index, 'takeaway')} set:html={takeaway} />
    )
  }

  <div class="pfig-body">
    <div class="pfig-media">
      {
        placeholder ? (
          /* Skeleton. Dev only — normalizeFigures drops placeholders from a
             production build, so this never reaches the live site. */
          <div class="pfig-skeleton" style={ratio ? `--figure-ratio: ${ratio};` : ''}>
            <p class="pfig-skeleton-kind">{KIND_LABEL[kind]} · to make</p>
            {title && <p class="pfig-skeleton-title">{title}</p>}
            {plan && <p class="pfig-skeleton-plan">{plan}</p>}
            {callouts.length > 0 && (
              <p class="pfig-skeleton-meta">
                {callouts.length} callout{callouts.length === 1 ? '' : 's'} positioned — drop the
                image in and they appear on it
              </p>
            )}
          </div>
        ) : compare && image ? (
          /* Before / after. Two frames, one caption, labels baked into the
             markup rather than the images so they translate and theme. */
          <div class="pfig-compare">
            <div class="pfig-frame" style={frameStyle}>
              <Image src={image} alt={`${beforeLabel}: ${alt}`} widths={[400, 800]} sizes="(min-width: 900px) 40vw, 100vw" loading="lazy" />
              <span class="pfig-compare-label">{beforeLabel}</span>
            </div>
            <div class="pfig-frame" style={frameStyle}>
              <Image src={compare} alt={`${afterLabel}: ${alt}`} widths={[400, 800]} sizes="(min-width: 900px) 40vw, 100vw" loading="lazy" />
              <span class="pfig-compare-label">{afterLabel}</span>
            </div>
          </div>
        ) : (
          <div class="pfig-frame" style={frameStyle}>
            {model ? (
              <Model3D src={model} alt={alt || caption || '3D model'} poster={poster} />
            ) : video ? (
              <video controls preload="metadata" playsinline poster={poster?.src} aria-label={alt || caption || 'Project video'}>
                <source src={videoSrc(video)} type="video/mp4" />
              </video>
            ) : (
              <Image
                src={image!}
                alt={alt}
                widths={[600, 1200, 1800]}
                sizes="(min-width: 1100px) 760px, 100vw"
                loading="lazy"
              />
            )}

            {/* Markers sit in the frame so they scroll and scale with it. */}
            {callouts.map((callout) => (
              <button
                type="button"
                class:list={['pfig-callout', `place-${callout.place}`]}
                style={`--cx: ${callout.x}%; --cy: ${callout.y}%;`}
                data-callout={String(callout.n)}
                aria-label={callout.label ? `Callout ${callout.n}: ${callout.label}` : `Callout ${callout.n}`}
                {...studio && { 'data-studio-callout': String(callout.n) }}
              >
                <span class="pfig-callout-dot">{callout.n}</span>
                {callout.label && <span class="pfig-callout-label">{callout.label}</span>}
              </button>
            ))}
          </div>
        )
      }
    </div>

    {
      hasAside && (
        <ol class="pfig-points">
          {points.map((point, i) => (
            <li data-point={String(i + 1)} data-tina-field={field?.(index, 'points')}>
              <span class="pfig-point-n">{i + 1}</span>
              <span class="pfig-point-text" set:html={point} />
            </li>
          ))}
        </ol>
      )
    }
  </div>

  {
    (caption || title) && !placeholder && (
      <figcaption data-tina-field={field?.(index, 'caption')}>
        <span class="pfig-fignum">Fig. {number}</span>
        {caption || title}
      </figcaption>
    )
  }
</figure>

<style>
  .pfig {
    margin: 2.5rem 0 3rem;
    /* Figures break out of the narrow reading column: a diagram needs width,
       a paragraph does not. The column stays narrow for text. */
    width: min(100%, 1040px);
    margin-inline: auto;
  }

  .pfig-takeaway {
    font-size: 1.25rem;
    line-height: 1.4;
    font-weight: 600;
    margin: 0 0 1rem;
    color: var(--text);
    max-width: 48ch;
  }

  .pfig-body {
    display: grid;
    gap: 1.25rem;
  }
  /* Grid items default to min-width:auto, which lets wide content push a
     column past its track. Everything in here must be allowed to shrink. */
  .pfig-media,
  .pfig-points {
    min-width: 0;
    max-width: 100%;
  }
  @media (min-width: 900px) {
    .pfig.has-aside .pfig-body {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
      gap: 2rem;
      align-items: start;
    }
  }

  /* --- the frame ------------------------------------------------------- */

  .pfig-frame {
    position: relative;
    overflow: visible; /* a callout label may sit past the edge */
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
  }
  .pfig-frame :global(img),
  .pfig-frame :global(video) {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: var(--figure-ratio, auto);
    object-fit: cover;
    object-position: var(--figure-focal, center center);
    transform: scale(var(--figure-zoom, 1));
    transform-origin: var(--figure-focal, center center);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    /* The zoom scales the image inside a frame that must still clip it. */
    clip-path: inset(0 round var(--radius-lg));
  }

  .pfig-compare {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 560px) {
    .pfig-compare {
      grid-template-columns: 1fr 1fr;
    }
  }
  .pfig-compare-label {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  /* --- callouts -------------------------------------------------------- */

  .pfig-callout {
    position: absolute;
    left: var(--cx);
    top: var(--cy);
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
    z-index: 2;
  }
  .pfig-callout-dot {
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    box-shadow: 0 0 0 2px var(--bg), var(--shadow);
    transition: transform var(--transition);
  }
  .pfig-callout-label {
    position: relative;
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.2rem 0.5rem;
    font-size: 0.78rem;
    line-height: 1.25;
    white-space: nowrap;
    box-shadow: var(--shadow);
  }
  /* Leader line from the dot to the label. Drawn on the label rather than the
     dot so it always starts at the label's own edge, whichever side it sits
     on — the gap it spans is the flex gap, so the two can never disagree. */
  .pfig-callout-label::before {
    content: '';
    position: absolute;
    background: var(--accent);
  }
  .place-right .pfig-callout-label::before {
    left: calc(-0.4rem - 1px);
    top: 50%;
    width: 0.4rem;
    height: 2px;
    transform: translateY(-50%);
  }
  .place-left .pfig-callout-label::before {
    right: calc(-0.4rem - 1px);
    top: 50%;
    width: 0.4rem;
    height: 2px;
    transform: translateY(-50%);
  }
  .place-down .pfig-callout-label::before {
    top: calc(-0.4rem - 1px);
    left: 50%;
    height: 0.4rem;
    width: 2px;
    transform: translateX(-50%);
  }
  .place-up .pfig-callout-label::before {
    bottom: calc(-0.4rem - 1px);
    left: 50%;
    height: 0.4rem;
    width: 2px;
    transform: translateX(-50%);
  }
  /* The label flips to the other side of the dot so a marker near the right
     edge doesn't push its text off the picture. */
  .pfig-callout.place-left {
    flex-direction: row-reverse;
  }
  .pfig-callout.place-up {
    flex-direction: column-reverse;
  }
  .pfig-callout.place-down {
    flex-direction: column;
  }

  /* Labels are decoration on a small screen — the numbered list below carries
     the same text, so hiding them costs nothing and saves a pile of overlap. */
  @media (max-width: 700px) {
    .pfig-callout-label {
      display: none;
    }
  }

  .pfig-callout:hover .pfig-callout-dot,
  .pfig-callout:focus-visible .pfig-callout-dot,
  .pfig-callout.is-active .pfig-callout-dot {
    transform: scale(1.25);
  }
  .pfig-callout:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 999px;
  }

  /* --- points ---------------------------------------------------------- */

  .pfig-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
    align-content: start;
  }
  .pfig-points li {
    display: grid;
    grid-template-columns: 1.6rem 1fr;
    gap: 0.6rem;
    align-items: start;
    font-size: 0.97rem;
    line-height: 1.5;
    padding: 0.25rem;
    border-radius: var(--radius);
    transition: background var(--transition);
  }
  .pfig-points li.is-active {
    background: var(--bg-elevated);
  }
  .pfig-point-n {
    width: 1.6rem;
    height: 1.6rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .pfig-points li.is-active .pfig-point-n {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .pfig-point-text :global(strong) {
    font-weight: 650;
  }

  /* --- caption --------------------------------------------------------- */

  .pfig figcaption {
    margin-top: 0.85rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }
  .pfig-fignum {
    flex: none;
    font-weight: 700;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  /* --- placeholder skeleton (dev only) --------------------------------- */

  .pfig-skeleton {
    display: grid;
    align-content: center;
    gap: 0.5rem;
    /* `width: 100%` is load-bearing, not tidiness. With width left auto, the
       aspect-ratio resolves against the MIN-HEIGHT instead — 220px at 16/9
       computed a 391px width inside a 335px column and pushed the whole page
       into horizontal scroll on a phone. A definite width makes the ratio
       derive the height, which is the direction intended. */
    width: 100%;
    min-height: 220px;
    aspect-ratio: var(--figure-ratio, 16 / 9);
    padding: 1.5rem;
    border: 2px dashed var(--border);
    border-radius: var(--radius-lg);
    background: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 12px,
      var(--bg-elevated) 12px,
      var(--bg-elevated) 24px
    );
    text-align: center;
  }
  .pfig-skeleton p {
    margin: 0;
  }
  .pfig-skeleton-kind {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 700;
  }
  .pfig-skeleton-title {
    font-size: 1.05rem;
    font-weight: 650;
    color: var(--text);
  }
  .pfig-skeleton-plan {
    font-size: 0.9rem;
    color: var(--text-muted);
    max-width: 52ch;
    margin-inline: auto !important;
    line-height: 1.5;
  }
  .pfig-skeleton-meta {
    font-size: 0.78rem;
    color: var(--text-muted);
    opacity: 0.8;
  }

  /* --- scroll reveal ---------------------------------------------------- */

  @media (prefers-reduced-motion: no-preference) {
    .pfig[data-reveal] {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }
    .pfig[data-reveal].is-visible {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  /**
   * Links a numbered point to its marker, and reveals figures on scroll.
   *
   * Bundled once for the whole site by Astro, so it queries every figure on
   * the page rather than being wired per instance.
   */
  const figures = document.querySelectorAll<HTMLElement>('.pfig');

  for (const figure of figures) {
    const callouts = figure.querySelectorAll<HTMLElement>('[data-callout]');
    const points = figure.querySelectorAll<HTMLElement>('[data-point]');
    if (!callouts.length) continue;

    const setActive = (n: string | null) => {
      for (const el of callouts) el.classList.toggle('is-active', el.dataset.callout === n);
      for (const el of points) el.classList.toggle('is-active', el.dataset.point === n);
    };

    // Pair them both ways: hovering a bullet lights its marker, hovering a
    // marker lights its bullet. Pointer events alone would leave a keyboard
    // user with no link at all, hence focusin.
    for (const el of [...callouts, ...points]) {
      const n = el.dataset.callout ?? el.dataset.point ?? null;
      el.addEventListener('pointerenter', () => setActive(n));
      el.addEventListener('focusin', () => setActive(n));
      el.addEventListener('pointerleave', () => setActive(null));
      el.addEventListener('focusout', () => setActive(null));
    }

    // Tapping a marker on a phone has no hover to rely on, so it scrolls the
    // matching bullet into view and leaves it highlighted.
    for (const el of callouts) {
      el.addEventListener('click', () => {
        const n = el.dataset.callout;
        const point = figure.querySelector<HTMLElement>(`[data-point="${n}"]`);
        setActive(n ?? null);
        point?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      });
    }
  }

  // Reveal on scroll. The attribute is added here, never in the HTML, so a
  // page with no JavaScript shows every figure instead of a blank column.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
    );
    for (const figure of figures) {
      figure.setAttribute('data-reveal', '');
      observer.observe(figure);
    }
  }
</script>
