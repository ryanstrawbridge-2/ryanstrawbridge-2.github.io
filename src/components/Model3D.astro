---
/**
 * Interactive 3D model in a gallery cell.
 *
 * Nothing loads until it's asked for. The viewer runtime is 283 KB gzipped —
 * more than this site's entire first load — and the model itself is megabytes
 * on top. Spending that on someone who scrolled past would be worse than not
 * offering it, so the cell shows a still frame and a button, and the script
 * and the model are fetched on the click.
 *
 * That also means it degrades honestly: with no JavaScript, you get the poster
 * and the caption, which is what a plain photo would have given you anyway.
 */
import { Image } from 'astro:assets';

interface Props {
  /** Filename in public/models/, e.g. "itd-release.glb". */
  src: string;
  alt: string;
  /** Still frame shown before it loads. */
  poster?: ImageMetadata;
  /** Shown on the button so the cost is visible before the click. */
  sizeLabel?: string;
}

import { statSync } from 'node:fs';
import { join } from 'node:path';

const { src, alt, poster, sizeLabel: givenLabel } = Astro.props;
const file = src.replace(/^\/?models\//, '');
const modelSrc = `/models/${file}`;
// The download size goes on the button, so the cost is visible before the click.
// `npm run model` renders a still next to the model; use it when the row
// doesn't name its own poster.
const autoPoster = file.replace(/\.glb$/i, '.webp');
let posterSrc = '';
try {
  statSync(join(process.cwd(), 'public/models', autoPoster));
  posterSrc = `/models/${autoPoster}`;
} catch { /* no still: the panel shows its background */ }
let sizeLabel = givenLabel;
if (!sizeLabel) {
  try {
    const bytes = statSync(join(process.cwd(), 'public/models', file)).size;
    sizeLabel = bytes > 1048576 ? `${(bytes / 1048576).toFixed(1)} MB` : `${Math.round(bytes / 1024)} KB`;
  } catch { /* missing file: the button just has no size */ }
}
---

<div class="model3d" data-model-src={modelSrc} data-model-alt={alt}>
  {poster ? (
    <Image src={poster} alt={alt} widths={[600, 1200]} sizes="(min-width: 760px) 760px, 100vw" loading="lazy" />
  ) : posterSrc ? (
    <img class="model3d-still" src={posterSrc} alt={alt} loading="lazy" decoding="async" />
  ) : null}
  <div class="model3d-overlay">
    <button type="button" class="model3d-load">
      View in 3D{sizeLabel ? ` · ${sizeLabel}` : ''}
    </button>
    <p class="model3d-note">Drag to rotate · scroll to zoom</p>
  </div>
  <noscript>
    <p class="model3d-note">The 3D viewer needs JavaScript.</p>
  </noscript>
</div>

<style>
  .model3d {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    display: grid;
    /* A CAD model needs room to turn. width: 100% is load-bearing: with an
       aspect-ratio and a min-height, an auto width resolves from the height
       and overflows a phone column (gotcha 45). */
    width: 100%;
    aspect-ratio: 4 / 3;
    min-height: 320px;
  }
  .model3d :global(img),
  .model3d :global(model-viewer) {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    display: block;
    min-height: 320px;
    object-fit: cover;
  }
  .model3d .model3d-still {
    object-fit: contain;
    padding: 4%;
    box-sizing: border-box;
  }
  .model3d.is-loaded .model3d-still {
    visibility: hidden;
  }
  .model3d :global(model-viewer) {
    /* The viewer takes the pointer once it exists, so the page can't be
       scrolled by dragging over it — this keeps one-finger scroll working and
       asks for two fingers to orbit, which is model-viewer's own convention. */
    --poster-color: transparent;
    background: var(--bg-subtle);
  }
  .model3d-overlay {
    grid-area: 1 / 1;
    /* Bottom, so the button sits under the model instead of across it. */
    place-self: end center;
    display: grid;
    gap: 0.4rem;
    justify-items: center;
    z-index: 1;
    padding: 1rem;
    text-align: center;
  }
  .model3d.is-loaded .model3d-overlay {
    display: none;
  }
  .model3d-load {
    background: var(--accent);
    color: white;
    border: 0;
    border-radius: 999px;
    padding: 0.5rem 1.1rem;
    font: inherit;
    cursor: pointer;
    box-shadow: var(--shadow);
    transition: background var(--transition);
  }
  .model3d-load:hover {
    background: var(--accent-hover);
  }
  .model3d-load[disabled] {
    opacity: 0.7;
    cursor: default;
  }
  .model3d-note {
    margin: 0;
    font-size: 0.78rem;
    color: var(--text-muted);
    background: var(--bg);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
  }
</style>

<script>
  for (const host of document.querySelectorAll<HTMLElement>('.model3d')) {
    const button = host.querySelector('button.model3d-load') as HTMLButtonElement | null;
    if (!button) continue;

    button.addEventListener(
      'click',
      async () => {
        button.disabled = true;
        button.textContent = 'loading…';
        try {
          // Dynamic import: the 283 KB runtime is fetched here and nowhere
          // else, so a page with a model on it costs nothing until this runs.
          await import('@google/model-viewer');

          const viewer = document.createElement('model-viewer');
          viewer.setAttribute('src', host.dataset.modelSrc ?? '');
          viewer.setAttribute('alt', host.dataset.modelAlt ?? '');
          viewer.setAttribute('camera-controls', '');
          viewer.setAttribute('touch-action', 'pan-y');
          viewer.setAttribute('shadow-intensity', '1');
          viewer.setAttribute('exposure', '1');
          viewer.setAttribute('ar', '');
          // A slow turn says "this is 3D" before anyone touches it; it stops
          // as soon as they do.
          viewer.setAttribute('auto-rotate', '');
          viewer.setAttribute('auto-rotate-delay', '0');
          viewer.setAttribute('rotation-per-second', '18deg');
          viewer.setAttribute('interaction-prompt', 'none');
          viewer.setAttribute('camera-orbit', '35deg 70deg auto');
          host.appendChild(viewer);

          viewer.addEventListener('load', () => host.classList.add('is-loaded'), { once: true });
          viewer.addEventListener(
            'error',
            () => {
              host.classList.remove('is-loaded');
              button.disabled = false;
              button.textContent = 'could not load the model';
            },
            { once: true },
          );
        } catch {
          button.disabled = false;
          button.textContent = 'could not load the viewer';
        }
      },
      { once: false },
    );
  }
</script>
