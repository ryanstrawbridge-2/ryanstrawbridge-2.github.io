---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import site from '../../data/site.json';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) =>
    a.data.order - b.data.order ||
    b.data.date.valueOf() - a.data.date.valueOf(),
);
// Optional filter chips (studio Theme panel: "Projects page filter").
// Off unless switched on, so the page is unchanged by default.
const filterBy = (site as Record<string, unknown>).projectFilter === 'organization' ? 'organization' : null;
const groupOf = (p: (typeof projects)[number]) => (p.data.organization ?? 'Personal').replace(/\s*[–-].*$/, '').trim();
const groups = filterBy ? [...new Set(projects.map(groupOf))] : [];
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<BaseLayout title="Projects · Ryan Strawbridge">
  <section class="section">
    <div class="container">
      <header class="page-head">
        <p class="eyebrow">Portfolio</p>
        <h1>Projects</h1>
        <p class="muted">
          Mechanical design work spanning fusion energy manufacturing, aerospace propulsion, defense
          electronics, and small personal builds.
        </p>
      </header>
      <h2 class="sr-only">Project list</h2>
      {groups.length > 1 && (
        <div class="filters" role="group" aria-label="Filter projects">
          <button type="button" class="filter is-on" data-filter="all" aria-pressed="true">All</button>
          {groups.map((g) => <button type="button" class="filter" data-filter={slug(g)} aria-pressed="false">{g}</button>)}
        </div>
      )}
      <div class="project-grid">
        {projects.map((project) => (
          <div class="project-cell" data-group={filterBy ? slug(groupOf(project)) : undefined}>
            <ProjectCard project={project} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    const bar = document.querySelector('.filters');
    bar?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.filter');
      if (!button) return;
      const value = button.dataset.filter;
      for (const b of bar.querySelectorAll<HTMLButtonElement>('.filter')) {
        const on = b === button;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-pressed', String(on));
      }
      for (const cell of document.querySelectorAll<HTMLElement>('.project-cell')) {
        cell.hidden = value !== 'all' && cell.dataset.group !== value;
      }
    });
  </script>

  <style>
    .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: -1.5rem 0 2rem; }
    .filter {
      font: inherit; font-size: 0.9rem; font-weight: 600; padding: 0.4rem 0.9rem; border-radius: 999px; cursor: pointer;
      border: 1px solid var(--border-strong); background: transparent; color: var(--text); transition: all var(--transition);
    }
    .filter:hover { border-color: var(--text); }
    .filter.is-on { background: var(--text); color: var(--bg); border-color: var(--text); }
    .project-cell { display: contents; }
    .project-cell[hidden] { display: none; }
    .page-head {
      max-width: 720px;
      margin-bottom: 3rem;
    }
    .page-head h1 {
      margin: 0.25rem 0 1rem;
    }
    .project-grid {
      display: grid;
      gap: 1.5rem;
      grid-template-columns: 1fr;
    }
    @media (min-width: 720px) {
      .project-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  </style>
</BaseLayout>
