---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import StudioOverlay from '../../components/StudioOverlay.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import TinaEditBridge from '../../components/TinaEditBridge.astro';
import {
  PROJECT_QUERY,
  asTinaDocument,
  projectField,
  queryId,
} from '../../lib/tina-visual-editing';
import {
  focalCss,
  groupBySection,
  normalizeGallery,
  splitBodySections,
} from '../../lib/gallery';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const {
  title,
  subtitle,
  organization,
  date,
  summary,
  hero,
  heroAlt,
  tools,
  heroFocalPoint,
  heroAspect,
  galleryLayout,
  gallery,
} = project.data;

// Format in UTC. Frontmatter dates are UTC midnight and stand for a calendar
// month, not an instant — formatting them in a negative-offset timezone rolls
// any date on the 1st back into the previous month.
const dateLabel = date.toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const aspectCss: Record<typeof heroAspect, string> = {
  wide: '21 / 9',
  standard: '3 / 2',
  tall: '4 / 5',
  square: '1 / 1',
};
const heroStyle = `--hero-focal: ${focalCss(heroFocalPoint)}; --hero-aspect: ${aspectCss[heroAspect]};`;

// ---------------------------------------------------------------------------
// Gallery placement
//
// Items that name a body heading render at the end of that section; everything
// else collects at the bottom of the page, which is the old behavior.
//
// Splitting works on the pre-rendered HTML, which is only safe when the body
// has no images of its own: markdown images come through as placeholders that
// <Content /> resolves, and set:html would emit them raw. If this project ever
// gains a body image, the split is skipped and every item trails instead — the
// page still works, the photos just stop being inline.
// ---------------------------------------------------------------------------
const rendered = (project as { rendered?: { html?: string; metadata?: { imagePaths?: string[] } } })
  .rendered;
const bodyHasImages = (rendered?.metadata?.imagePaths?.length ?? 0) > 0;
const bodyChunks = bodyHasImages ? [] : splitBodySections(rendered?.html ?? '');

const galleryItems = normalizeGallery(gallery, galleryLayout);
const { bySection, trailing } = groupBySection(galleryItems, bodyChunks);
const useInlineBody = bodyChunks.length > 0 && bySection.size > 0;

const all = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) =>
    a.data.order - b.data.order ||
    b.data.date.valueOf() - a.data.date.valueOf(),
);
const idx = all.findIndex((p) => p.id === project.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;

const tinaVariables = { relativePath: `${project.id}.md` };
const tinaId = queryId(PROJECT_QUERY, tinaVariables);
const tinaData = {
  project: asTinaDocument('Project', `${project.id}.md`, 'src/content/projects', {
    ...project.data,
    date: date.toISOString(),
  }),
};
const f = (...path: (string | number)[]) => projectField(project.id, ...path);
const galleryField = (index: number, key: string) => f('gallery', index, key);
---

<BaseLayout title={`${title} · Ryan Strawbridge`} description={summary}>
  <article>
    <header class="project-hero">
      <div class="container">
        <p class="eyebrow" data-tina-field={f(organization ? 'organization' : 'date')}>
          {organization ?? subtitle ?? 'Project'} <span class="dot">·</span> {dateLabel}
        </p>
        <h1 data-tina-field={f('title')}>{title}</h1>
        {subtitle && organization && <p class="subtitle muted" data-tina-field={f('subtitle')}>{subtitle}</p>}
        <p class="summary" data-tina-field={f('summary')}>{summary}</p>
        {
          tools.length > 0 && (
            <ul class="tags">
              {tools.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          )
        }
      </div>
    </header>

    <div class="hero-image-wrap container" style={heroStyle} data-tina-field={f('hero')}>
      <Image
        src={hero}
        alt={heroAlt}
        widths={[600, 1200, 1800]}
        sizes="(min-width: 1100px) 1100px, 100vw"
        class="hero-image"
      />
    </div>

    {/* One lightbox root wraps body and gallery — the lightbox binds to the
        first root it finds, so they have to share it to navigate as one set. */}
    <div data-lightbox-root data-studio-slug={import.meta.env.DEV ? project.id : undefined}>
      <div class="container-narrow project-body" data-tina-field={f('body')}>
        {
          useInlineBody ? (
            bodyChunks.map((chunk) => (
              <>
                <Fragment set:html={chunk.html} />
                <GalleryGrid
                  items={bySection.get(chunk.id) ?? []}
                  field={galleryField}
                  class="section-gallery"
                />
              </>
            ))
          ) : (
            <Content />
          )
        }
      </div>

      {
        trailing.length > 0 && (
          <div class="container-narrow">
            <GalleryGrid items={trailing} field={galleryField} class="trailing-gallery" />
          </div>
        )
      }
    </div>

    <TinaEditBridge query={PROJECT_QUERY} variables={tinaVariables} data={tinaData} id={tinaId} />

    <Lightbox />

    {/* Dev only. Renders nothing in a production build. */}
    <StudioOverlay headings={bodyChunks.map((c) => c.id).filter(Boolean)} />

    <nav class="project-nav container" aria-label="Project navigation">
      <a href="/projects/" class="all">← All projects</a>
      <div class="adjacent">
        {prev && (
          <a href={`/projects/${prev.id}/`} class="adjacent-link">
            <span class="muted">Previous</span>
            <span>{prev.data.title}</span>
          </a>
        )}
        {next && (
          <a href={`/projects/${next.id}/`} class="adjacent-link adjacent-right">
            <span class="muted">Next</span>
            <span>{next.data.title}</span>
          </a>
        )}
      </div>
    </nav>
  </article>

  <style>
    .project-hero {
      padding-block: 4rem 2.5rem;
    }
    .project-hero h1 {
      margin: 0.5rem 0 0.75rem;
    }
    .subtitle {
      font-size: 1.1rem;
      margin: 0 0 1rem;
    }
    .summary {
      font-size: 1.15rem;
      max-width: 720px;
      color: var(--text);
    }
    .tags {
      list-style: none;
      padding: 0;
      margin: 1.5rem 0 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .tags li {
      padding: 0.3rem 0.7rem;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 999px;
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .hero-image-wrap {
      margin-bottom: 3rem;
    }
    .hero-image-wrap :global(.hero-image) {
      width: 100%;
      aspect-ratio: var(--hero-aspect, 21 / 9);
      max-height: 640px;
      object-fit: cover;
      object-position: var(--hero-focal, center center);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
    }

    .project-body {
      padding-block: 1rem 4rem;
      font-size: 1.05rem;
    }
    .project-body :global(h2) {
      margin-top: 2.5rem;
      margin-bottom: 0.75rem;
      font-size: 1.5rem;
    }
    .project-body :global(h2:first-child) {
      margin-top: 0;
    }
    .project-body :global(h3) {
      margin-top: 1.75rem;
      font-size: 1.15rem;
    }
    .project-body :global(ul),
    .project-body :global(ol) {
      padding-left: 1.25rem;
    }
    .project-body :global(li) {
      margin-bottom: 0.4rem;
    }
    .project-body :global(img) {
      margin-block: 1.5rem;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow);
    }
    /* Figures generated by rehype-image-captions: an image written into the
       body markdown gets wrapped in <figure> with its alt text as a caption. */
    .project-body :global(figure.gallery-figure) {
      margin: 0;
      display: flex;
      flex-direction: column;
    }
    .project-body :global(figure.gallery-figure) :global(img) {
      margin: 0;
      width: 100%;
      cursor: zoom-in;
    }
    .project-body :global(figure.gallery-figure) :global(figcaption) {
      font-size: 0.85rem;
      color: var(--text-muted);
      text-align: center;
      margin-top: 0.5rem;
      padding-inline: 0.25rem;
    }
    /* Non-gallery figures (if any are added by hand) keep their old spacing. */
    .project-body :global(figure):not(.gallery-figure) {
      margin: 2rem 0;
    }
    .project-body :global(figure):not(.gallery-figure) :global(figcaption) {
      font-size: 0.9rem;
      color: var(--text-muted);
      text-align: center;
      margin-top: 0.5rem;
    }
    .project-body :global(blockquote) {
      border-left: 3px solid var(--accent);
      padding-left: 1rem;
      margin: 1.5rem 0;
      color: var(--text-muted);
      font-style: italic;
    }

    .project-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      justify-content: space-between;
      align-items: center;
      padding-block: 2rem 4rem;
      border-top: 1px solid var(--border);
      margin-top: 2rem;
    }
    .all {
      color: var(--text);
      font-weight: 500;
    }
    .all:hover {
      color: var(--accent);
    }
    .adjacent {
      display: flex;
      gap: 1.5rem;
    }
    .adjacent-link {
      display: flex;
      flex-direction: column;
      color: var(--text);
      text-align: right;
      font-size: 0.95rem;
      gap: 0.15rem;
    }
    .adjacent-link span:last-child {
      font-weight: 600;
    }
    .adjacent-link:hover span:last-child {
      color: var(--accent);
    }
  </style>
</BaseLayout>
