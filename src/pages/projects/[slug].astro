---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import TinaEditBridge from '../../components/TinaEditBridge.astro';
import {
  PROJECT_QUERY,
  asTinaDocument,
  projectField,
  queryId,
} from '../../lib/tina-visual-editing';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const {
  title,
  subtitle,
  organization,
  date,
  summary,
  hero,
  heroAlt,
  tools,
  heroFocalPoint,
  heroAspect,
  galleryLayout,
  gallery,
} = project.data;

// Format in UTC. Frontmatter dates are UTC midnight and stand for a calendar
// month, not an instant — formatting them in a negative-offset timezone rolls
// any date on the 1st back into the previous month.
const dateLabel = date.toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

// Map the 9-way friendly keywords to CSS object-position values.
// If heroFocalPoint isn't one of these keywords, treat it as a raw CSS value
// (e.g. "37% 22%" from focal-picker.html).
const focalKeywordCss: Record<string, string> = {
  'top-left': 'top left',
  top: 'top center',
  'top-right': 'top right',
  left: 'center left',
  center: 'center center',
  right: 'center right',
  'bottom-left': 'bottom left',
  bottom: 'bottom center',
  'bottom-right': 'bottom right',
};
const focalCss = (value: string) => focalKeywordCss[value] ?? value;
const aspectCss: Record<typeof heroAspect, string> = {
  wide: '21 / 9',
  standard: '3 / 2',
  tall: '4 / 5',
  square: '1 / 1',
};
const heroStyle = `--hero-focal: ${focalCss(heroFocalPoint)}; --hero-aspect: ${aspectCss[heroAspect]};`;

const all = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) =>
    a.data.order - b.data.order ||
    b.data.date.valueOf() - a.data.date.valueOf(),
);
const idx = all.findIndex((p) => p.id === project.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;

const tinaVariables = { relativePath: `${project.id}.md` };
const tinaId = queryId(PROJECT_QUERY, tinaVariables);
const tinaData = {
  project: asTinaDocument('Project', `${project.id}.md`, 'src/content/projects', {
    ...project.data,
    date: date.toISOString(),
  }),
};
const f = (...path: (string | number)[]) => projectField(project.id, ...path);
---

<BaseLayout title={`${title} · Ryan Strawbridge`} description={summary}>
  <article>
    <header class="project-hero">
      <div class="container">
        <p class="eyebrow" data-tina-field={f(organization ? 'organization' : 'date')}>
          {organization ?? subtitle ?? 'Project'} <span class="dot">·</span> {dateLabel}
        </p>
        <h1 data-tina-field={f('title')}>{title}</h1>
        {subtitle && organization && <p class="subtitle muted" data-tina-field={f('subtitle')}>{subtitle}</p>}
        <p class="summary" data-tina-field={f('summary')}>{summary}</p>
        {
          tools.length > 0 && (
            <ul class="tags">
              {tools.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          )
        }
      </div>
    </header>

    <div class="hero-image-wrap container" style={heroStyle} data-tina-field={f('hero')}>
      <Image
        src={hero}
        alt={heroAlt}
        widths={[600, 1200, 1800]}
        sizes="(min-width: 1100px) 1100px, 100vw"
        class="hero-image"
      />
    </div>

    {/* One lightbox root wraps both — the lightbox binds to the first root it
        finds, so body and gallery images have to share it to navigate as one set. */}
    <div data-lightbox-root>
      <div class={`container-narrow project-body gallery-${galleryLayout}`} data-tina-field={f('body')}>
        <Content />
      </div>

      {
        gallery.length > 0 && (
          <div class={`container-narrow project-gallery gallery-${galleryLayout}`}>
            {gallery.map((item, i) => (
              <figure class="gallery-figure" data-tina-field={f('gallery', i, 'image')}>
                <Image
                  src={item.image}
                  alt={item.alt ?? item.caption ?? title}
                  /* Cells cap out around 350px in the two-column grid and 760px
                     stacked, so 800w covers stacked 1x and two-column 2x. */
                  widths={[400, 800]}
                  sizes="(min-width: 720px) 50vw, 100vw"
                  loading="lazy"
                />
                {(item.caption ?? item.alt) && <figcaption>{item.caption ?? item.alt}</figcaption>}
              </figure>
            ))}
          </div>
        )
      }
    </div>

    <TinaEditBridge query={PROJECT_QUERY} variables={tinaVariables} data={tinaData} id={tinaId} />

    <Lightbox />

    <nav class="project-nav container" aria-label="Project navigation">
      <a href="/projects/" class="all">← All projects</a>
      <div class="adjacent">
        {prev && (
          <a href={`/projects/${prev.id}/`} class="adjacent-link">
            <span class="muted">Previous</span>
            <span>{prev.data.title}</span>
          </a>
        )}
        {next && (
          <a href={`/projects/${next.id}/`} class="adjacent-link adjacent-right">
            <span class="muted">Next</span>
            <span>{next.data.title}</span>
          </a>
        )}
      </div>
    </nav>
  </article>

  <style>
    .project-hero {
      padding-block: 4rem 2.5rem;
    }
    .project-hero h1 {
      margin: 0.5rem 0 0.75rem;
    }
    .subtitle {
      font-size: 1.1rem;
      margin: 0 0 1rem;
    }
    .summary {
      font-size: 1.15rem;
      max-width: 720px;
      color: var(--text);
    }
    .tags {
      list-style: none;
      padding: 0;
      margin: 1.5rem 0 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .tags li {
      padding: 0.3rem 0.7rem;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 999px;
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .hero-image-wrap {
      margin-bottom: 3rem;
    }
    .hero-image-wrap :global(.hero-image) {
      width: 100%;
      aspect-ratio: var(--hero-aspect, 21 / 9);
      max-height: 640px;
      object-fit: cover;
      object-position: var(--hero-focal, center center);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
    }

    .project-body {
      padding-block: 1rem 4rem;
      font-size: 1.05rem;
    }
    .project-body :global(h2) {
      margin-top: 2.5rem;
      margin-bottom: 0.75rem;
      font-size: 1.5rem;
    }
    .project-body :global(h2:first-child) {
      margin-top: 0;
    }
    .project-body :global(h3) {
      margin-top: 1.75rem;
      font-size: 1.15rem;
    }
    .project-body :global(ul),
    .project-body :global(ol) {
      padding-left: 1.25rem;
    }
    .project-body :global(li) {
      margin-bottom: 0.4rem;
    }
    .project-body :global(img) {
      margin-block: 1.5rem;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow);
    }
    /* Figures generated by rehype-image-captions: each gallery image is
       wrapped in <figure> with a <figcaption> built from its alt text. */
    .project-body :global(figure.gallery-figure) {
      margin: 0;
      display: flex;
      flex-direction: column;
    }
    .project-body :global(figure.gallery-figure) :global(img) {
      margin: 0;
      width: 100%;
      cursor: zoom-in;
    }
    .project-body :global(figure.gallery-figure) :global(figcaption) {
      font-size: 0.85rem;
      color: var(--text-muted);
      text-align: center;
      margin-top: 0.5rem;
      padding-inline: 0.25rem;
    }
    /* Non-gallery figures (if any are added by hand) keep their old spacing. */
    .project-body :global(figure):not(.gallery-figure) {
      margin: 2rem 0;
    }
    .project-body :global(figure):not(.gallery-figure) :global(figcaption) {
      font-size: 0.9rem;
      color: var(--text-muted);
      text-align: center;
      margin-top: 0.5rem;
    }
    .project-body :global(blockquote) {
      border-left: 3px solid var(--accent);
      padding-left: 1rem;
      margin: 1.5rem 0;
      color: var(--text-muted);
      font-style: italic;
    }

    /* The gallery frontmatter list renders here. Mirrors the figure styling
       body images get from rehype-image-captions, so moving a photo between
       the body and the gallery list looks the same either way. */
    .project-gallery :global(figure.gallery-figure) {
      margin: 0;
      display: flex;
      flex-direction: column;
    }
    .project-gallery :global(figure.gallery-figure) :global(img) {
      margin: 0;
      width: 100%;
      cursor: zoom-in;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow);
    }
    .project-gallery :global(figure.gallery-figure) :global(figcaption) {
      font-size: 0.85rem;
      color: var(--text-muted);
      text-align: center;
      margin-top: 0.5rem;
      padding-inline: 0.25rem;
    }
    .project-gallery.gallery-stacked :global(figure.gallery-figure) {
      margin-block: 1.5rem;
    }

    /* Gallery layouts: text content spans full width; gallery figures flow
       into a multi-column grid. */
    .project-body.gallery-two-column,
    .project-body.gallery-three-column,
    .project-gallery.gallery-two-column,
    .project-gallery.gallery-three-column {
      display: grid;
      gap: 1.5rem 1.25rem;
    }
    .project-body.gallery-two-column,
    .project-gallery.gallery-two-column {
      grid-template-columns: repeat(2, 1fr);
    }
    .project-body.gallery-three-column,
    .project-gallery.gallery-three-column {
      grid-template-columns: repeat(3, 1fr);
    }
    @media (max-width: 720px) {
      .project-body.gallery-two-column,
      .project-body.gallery-three-column,
      .project-gallery.gallery-two-column,
      .project-gallery.gallery-three-column {
        grid-template-columns: 1fr;
      }
    }
    /* Non-figure top-level elements span the full grid row */
    .project-body.gallery-two-column > :global(:not(figure)),
    .project-body.gallery-three-column > :global(:not(figure)) {
      grid-column: 1 / -1;
    }
    /* Constrain figure images to a uniform 4:3 cell — keeps the grid clean
       even when source photos have different aspect ratios. */
    .project-body.gallery-two-column :global(figure.gallery-figure) :global(img),
    .project-body.gallery-three-column :global(figure.gallery-figure) :global(img),
    .project-gallery.gallery-two-column :global(figure.gallery-figure) :global(img),
    .project-gallery.gallery-three-column :global(figure.gallery-figure) :global(img) {
      aspect-ratio: 4 / 3;
      object-fit: cover;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow);
    }

    .project-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      justify-content: space-between;
      align-items: center;
      padding-block: 2rem 4rem;
      border-top: 1px solid var(--border);
      margin-top: 2rem;
    }
    .all {
      color: var(--text);
      font-weight: 500;
    }
    .all:hover {
      color: var(--accent);
    }
    .adjacent {
      display: flex;
      gap: 1.5rem;
    }
    .adjacent-link {
      display: flex;
      flex-direction: column;
      color: var(--text);
      text-align: right;
      font-size: 0.95rem;
      gap: 0.15rem;
    }
    .adjacent-link span:last-child {
      font-weight: 600;
    }
    .adjacent-link:hover span:last-child {
      color: var(--accent);
    }
  </style>
</BaseLayout>
