---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import StudioOverlay from '../../components/StudioOverlay.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import ProjectFigure from '../../components/ProjectFigure.astro';
import TinaEditBridge from '../../components/TinaEditBridge.astro';
import {
  PROJECT_QUERY,
  asTinaDocument,
  projectField,
  queryId,
} from '../../lib/tina-visual-editing';
import {
  clampZoom,
  focalCss,
  groupBySection,
  normalizeGallery,
  splitBodySections,
} from '../../lib/gallery';
import { groupFigures, normalizeFigures } from '../../lib/figures';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const {
  title,
  subtitle,
  organization,
  date,
  summary,
  hero,
  heroAlt,
  heroFocalPoint,
  heroAspect,
  heroZoom,
  galleryLayout,
  gallery,
  figures,
} = project.data;

// Format in UTC. Frontmatter dates are UTC midnight and stand for a calendar
// month, not an instant — formatting them in a negative-offset timezone rolls
// any date on the 1st back into the previous month.
const dateLabel = date.toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const aspectCss: Record<typeof heroAspect, string> = {
  wide: '21 / 9',
  standard: '3 / 2',
  tall: '4 / 5',
  square: '1 / 1',
};
const heroStyle = `--hero-focal: ${focalCss(heroFocalPoint)}; --hero-aspect: ${aspectCss[heroAspect]}; --hero-zoom: ${clampZoom(heroZoom)};`;

// ---------------------------------------------------------------------------
// Gallery placement
//
// Items that name a body heading render at the end of that section; everything
// else collects at the bottom of the page, which is the old behavior.
//
// Splitting works on the pre-rendered HTML, which is only safe when the body
// has no images of its own: markdown images come through as placeholders that
// <Content /> resolves, and set:html would emit them raw. If this project ever
// gains a body image, the split is skipped and every item trails instead — the
// page still works, the photos just stop being inline.
// ---------------------------------------------------------------------------
const rendered = (project as { rendered?: { html?: string; metadata?: { imagePaths?: string[] } } })
  .rendered;
const bodyHasImages = (rendered?.metadata?.imagePaths?.length ?? 0) > 0;
const bodyChunks = bodyHasImages ? [] : splitBodySections(rendered?.html ?? '');

const galleryItems = normalizeGallery(gallery, galleryLayout);
const { bySection, trailing } = groupBySection(galleryItems, bodyChunks);

// Placeholders are a dev-time scaffold: they show where a diagram is going to
// go while it's still being drawn, and are dropped from a production build so
// an unfinished page can't ship a row of empty boxes.
const figureItems = normalizeFigures(figures, import.meta.env.DEV);
const { bySection: figuresBySection, trailing: trailingFigures } = groupFigures(
  figureItems,
  bodyChunks,
);

// Inline placement needs the body split to have worked AND something to place.
// In dev it always splits, so studio can edit each section on its own.
const useInlineBody =
  bodyChunks.length > 0 &&
  (bySection.size > 0 || figuresBySection.size > 0 || import.meta.env.DEV);

// Jump links in the sticky rail. Derived from the headings that actually
// rendered, so a project that drops a section doesn't get a dead link.
const HEADING_LABELS: Record<string, string> = {
  problem: 'Problem',
  'what-i-did': 'What I did',
  outcome: 'Outcome',
};
const sectionLinks = bodyChunks
  .map((chunk) => chunk.id)
  .filter(Boolean)
  .map((id) => ({ id, label: HEADING_LABELS[id] ?? id.replace(/-/g, ' ') }));

const all = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) =>
    a.data.order - b.data.order ||
    b.data.date.valueOf() - a.data.date.valueOf(),
);
const idx = all.findIndex((p) => p.id === project.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;

const tinaVariables = { relativePath: `${project.id}.md` };
const tinaId = queryId(PROJECT_QUERY, tinaVariables);
// `figures` is deliberately NOT in this payload. TinaEditBridge serializes it
// into the production HTML, and tina/config.ts has no `figures` field, so
// including it would ship every figure's draft notes in the page source while
// Tina still dropped the whole list on save (gotcha 41). Pages CMS and studio
// edit figures; Tina does not see them.
const { figures: _figuresNotInTina, ...tinaFields } = project.data;
const tinaData = {
  project: asTinaDocument('Project', `${project.id}.md`, 'src/content/projects', {
    ...tinaFields,
    date: date.toISOString(),
  }),
};
const f = (...path: (string | number)[]) => projectField(project.id, ...path);
const galleryField = (index: number, key: string) => f('gallery', index, key);
const figureField = (index: number, key: string) => f('figures', index, key);
---

<BaseLayout title={`${title} · Ryan Strawbridge`} description={summary}>
  <article>
    <header class="project-hero">
      <div class="container">
        <p class="eyebrow" data-tina-field={f(organization ? 'organization' : 'date')}>
          {organization ?? subtitle ?? 'Project'} <span class="dot">·</span> {dateLabel}
        </p>
        <h1 data-tina-field={f('title')}>{title}</h1>
        {subtitle && organization && <p class="subtitle muted" data-tina-field={f('subtitle')}>{subtitle}</p>}
        <p class="summary" data-tina-field={f('summary')}>{summary}</p>
      </div>
    </header>

    <div
      class="hero-image-wrap container"
      style={heroStyle}
      data-tina-field={f('hero')}
      {...import.meta.env.DEV && {
        'data-studio-hero': '',
        'data-studio-focal': heroFocalPoint,
        'data-studio-zoom': String(clampZoom(heroZoom)),
        'data-studio-aspect': heroAspect,
        'data-studio-alt': heroAlt,
      }}
    >
      {/* The frame clips; the image scales inside it, so zoom crops at the
          rounded edge instead of spilling over the page. */}
      <div class="hero-frame">
        <Image
          src={hero}
          alt={heroAlt}
          widths={[600, 1200, 1800]}
          sizes="(min-width: 1100px) 1100px, 100vw"
          class="hero-image"
        />
      </div>
    </div>

    {/* One lightbox root wraps body, figures and gallery — the lightbox binds
        to the first root it finds, so they have to share it to navigate as one
        set. */}
    <div data-lightbox-root data-studio-slug={import.meta.env.DEV ? project.id : undefined}>
      <div class="container project-layout">
        <div class="project-main">
          <div class="project-body" data-tina-field={f('body')}>
            {
              useInlineBody ? (
                bodyChunks.map((chunk) => (
                  <>
                    {import.meta.env.DEV ? (
                      <div class="body-chunk" data-studio-section={chunk.id} set:html={chunk.html} />
                    ) : (
                      <Fragment set:html={chunk.html} />
                    )}
                    {/* Figures first, then plain photos: the walkthrough makes
                        the argument, the gallery is supporting material. */}
                    {(figuresBySection.get(chunk.id) ?? []).map((figure) => (
                      <ProjectFigure figure={figure} field={figureField} />
                    ))}
                    <GalleryGrid
                      items={bySection.get(chunk.id) ?? []}
                      field={galleryField}
                      class="section-gallery"
                    />
                  </>
                ))
              ) : (
                <Content />
              )
            }
          </div>

          {trailingFigures.map((figure) => (
            <ProjectFigure figure={figure} field={figureField} />
          ))}

          {
            trailing.length > 0 && (
              <GalleryGrid items={trailing} field={galleryField} class="trailing-gallery" />
            )
          }
        </div>

        {/* Sticky rail. Holds the facts you want while looking at a photo
            halfway down the page — who it was for and when — plus a jump list
            for the three sections. Tools are deliberately not shown on the
            project page. */}
        <aside class="project-rail" aria-label="Project details">
          <div class="rail-inner">
            {
              organization && (
                <div class="rail-block">
                  <p class="rail-label">Where</p>
                  <p class="rail-value" data-tina-field={f('organization')}>{organization}</p>
                </div>
              )
            }
            <div class="rail-block">
              <p class="rail-label">When</p>
              <p class="rail-value" data-tina-field={f('date')}>{dateLabel}</p>
            </div>
            {
              sectionLinks.length > 0 && (
                <nav class="rail-block rail-jump" aria-label="Sections">
                  <p class="rail-label">On this page</p>
                  <ul>
                    {sectionLinks.map((link) => (
                      <li>
                        <a href={`#${link.id}`}>{link.label}</a>
                      </li>
                    ))}
                  </ul>
                </nav>
              )
            }
          </div>
        </aside>
      </div>
    </div>

    <TinaEditBridge query={PROJECT_QUERY} variables={tinaVariables} data={tinaData} id={tinaId} />

    <Lightbox />

    {/* Dev only. Renders nothing in a production build. */}
    <StudioOverlay headings={bodyChunks.map((c) => c.id).filter(Boolean)} />

    {
      next && (
        <a href={`/projects/${next.id}/`} class="next-card container">
          <div class="next-card-text">
            <p class="next-card-label">Next project</p>
            <h2>{next.data.title}</h2>
            <p class="next-card-summary">{next.data.summary}</p>
            {next.data.organization && <p class="next-card-org">{next.data.organization}</p>}
          </div>
          <div class="next-card-image">
            <Image
              src={next.data.hero}
              alt=""
              widths={[400, 800]}
              sizes="(min-width: 900px) 420px, 100vw"
              loading="lazy"
            />
          </div>
        </a>
      )
    }

    <nav class="project-nav container" aria-label="Project navigation">
      <a href="/projects/" class="all">← All projects</a>
      <div class="adjacent">
        {prev && (
          <a href={`/projects/${prev.id}/`} class="adjacent-link">
            <span class="muted">Previous</span>
            <span>{prev.data.title}</span>
          </a>
        )}
      </div>
    </nav>
  </article>

  <style>
    .project-hero {
      padding-block: 4rem 2.5rem;
    }
    .project-hero h1 {
      margin: 0.5rem 0 0.75rem;
    }
    .subtitle {
      font-size: 1.1rem;
      margin: 0 0 1rem;
    }
    .summary {
      font-size: 1.15rem;
      max-width: 720px;
      color: var(--text);
    }
    /* --- layout: scrolling column + sticky rail ------------------------ */

    .project-layout {
      display: grid;
      gap: 2rem;
      align-items: start;
    }
    @media (min-width: 1000px) {
      .project-layout {
        grid-template-columns: minmax(0, 1fr) 250px;
        gap: 3.5rem;
      }
    }
    .project-main {
      min-width: 0;
    }

    .project-rail {
      /* Below 1000px the grid is one column and the rail reads as a plain
         block above the fold of the body — sticky would pin it over the text. */
      border-top: 1px solid var(--border);
      padding-top: 1.25rem;
    }
    @media (min-width: 1000px) {
      .project-rail {
        position: sticky;
        /* Clears the site header, which is itself sticky. */
        top: 5.5rem;
        border-top: 0;
        padding-top: 0;
        order: 2;
      }
    }
    .rail-inner {
      display: grid;
      gap: 1.5rem;
    }
    @media (max-width: 999px) {
      .rail-inner {
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 1.25rem 2rem;
      }
    }
    .rail-block p {
      margin: 0;
    }
    .rail-label {
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-muted);
      font-weight: 700;
      margin-bottom: 0.35rem !important;
    }
    .rail-value {
      font-size: 0.95rem;
      line-height: 1.4;
      color: var(--text);
    }
    .rail-jump ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.3rem;
      font-size: 0.9rem;
    }
    .rail-jump a {
      color: var(--text);
      text-decoration: none;
      border-left: 2px solid var(--border);
      padding-left: 0.6rem;
      display: block;
      line-height: 1.6;
    }
    .rail-jump a:hover {
      color: var(--accent);
      border-left-color: var(--accent);
    }

    /* --- next project card --------------------------------------------- */

    .next-card {
      display: grid;
      gap: 1.25rem;
      align-items: center;
      margin-top: 4rem;
      padding: 1.5rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      background: var(--bg-elevated);
      text-decoration: none;
      color: var(--text);
      transition: border-color var(--transition), transform var(--transition);
    }
    @media (min-width: 760px) {
      .next-card {
        grid-template-columns: minmax(0, 1fr) 320px;
        gap: 2.5rem;
        padding: 2rem;
      }
    }
    .next-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
    }
    .next-card-label {
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
      font-weight: 700;
      margin: 0 0 0.4rem;
    }
    .next-card h2 {
      margin: 0 0 0.5rem;
      font-size: 1.5rem;
    }
    .next-card-summary {
      margin: 0;
      color: var(--text-muted);
      font-size: 0.95rem;
      line-height: 1.5;
    }
    .next-card-org {
      margin: 0.6rem 0 0;
      font-size: 0.85rem;
      color: var(--text-muted);
    }
    .next-card-image :global(img) {
      width: 100%;
      aspect-ratio: 3 / 2;
      object-fit: cover;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    .hero-image-wrap {
      margin-bottom: 3rem;
    }
    .hero-frame {
      position: relative;
      overflow: hidden;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
      line-height: 0;
    }
    .hero-image-wrap :global(.hero-image) {
      display: block;
      width: 100%;
      aspect-ratio: var(--hero-aspect, 21 / 9);
      max-height: 640px;
      object-fit: cover;
      object-position: var(--hero-focal, center center);
      transform: scale(var(--hero-zoom, 1));
      transform-origin: var(--hero-focal, center center);
    }

    .project-body {
      padding-block: 1rem 2rem;
      font-size: 1.05rem;
    }
    /* Text keeps a comfortable measure while figures take the whole column —
       a paragraph and a schematic do not want the same width. */
    .project-body :global(p),
    .project-body :global(ul),
    .project-body :global(ol),
    .project-body :global(blockquote) {
      max-width: 68ch;
    }
    .project-body :global(h2) {
      margin-top: 2.5rem;
      margin-bottom: 0.75rem;
      font-size: 1.5rem;
    }
    .project-body :global(h2:first-child) {
      margin-top: 0;
    }
    .project-body :global(h3) {
      margin-top: 1.75rem;
      font-size: 1.15rem;
    }
    .project-body :global(ul),
    .project-body :global(ol) {
      padding-left: 1.25rem;
    }
    /* Dev-only wrapper so studio can find each section; no layout of its own. */
    .project-body :global(.body-chunk) {
      display: contents;
    }
    .project-body :global(li) {
      margin-bottom: 0.4rem;
    }
    .project-body :global(img) {
      margin-block: 1.5rem;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow);
    }
    /* Figures generated by rehype-image-captions: an image written into the
       body markdown gets wrapped in <figure> with its alt text as a caption. */
    .project-body :global(figure.gallery-figure) {
      margin: 0;
      display: flex;
      flex-direction: column;
    }
    /* Walkthrough figure frames size and clip their own photos; the prose
       margin above pushed them 24px down and over the caption. */
    .project-body :global(.pfig-frame img) {
      margin: 0;
    }
    .project-body :global(figure.gallery-figure) :global(img) {
      margin: 0;
      width: 100%;
      cursor: zoom-in;
    }
    .project-body :global(figure.gallery-figure) :global(figcaption) {
      font-size: 0.85rem;
      color: var(--text-muted);
      text-align: center;
      margin-top: 0.5rem;
      padding-inline: 0.25rem;
    }
    /* Non-gallery figures (if any are added by hand) keep their old spacing. */
    .project-body :global(figure):not(.gallery-figure) {
      margin: 2rem 0;
    }
    .project-body :global(figure):not(.gallery-figure) :global(figcaption) {
      font-size: 0.9rem;
      color: var(--text-muted);
      text-align: center;
      margin-top: 0.5rem;
    }
    .project-body :global(blockquote) {
      border-left: 3px solid var(--accent);
      padding-left: 1rem;
      margin: 1.5rem 0;
      color: var(--text-muted);
      font-style: italic;
    }

    .project-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      justify-content: space-between;
      align-items: center;
      padding-block: 2rem 4rem;
      border-top: 1px solid var(--border);
      margin-top: 2rem;
    }
    .all {
      color: var(--text);
      font-weight: 500;
    }
    .all:hover {
      color: var(--accent);
    }
    .adjacent {
      display: flex;
      gap: 1.5rem;
    }
    .adjacent-link {
      display: flex;
      flex-direction: column;
      color: var(--text);
      text-align: right;
      font-size: 0.95rem;
      gap: 0.15rem;
    }
    .adjacent-link span:last-child {
      font-weight: 600;
    }
    .adjacent-link:hover span:last-child {
      color: var(--accent);
    }
  </style>
</BaseLayout>
