---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import home from '../data/home.json';
import { inlineEmphasis } from '../lib/inline-emphasis';
import { resolveSiteImage } from '../lib/site-images';
import { focalCss, clampZoom } from '../lib/gallery';
import StudioOverlay from '../components/StudioOverlay.astro';
import SectionBlock from '../components/SectionBlock.astro';
import Lightbox from '../components/Lightbox.astro';
import { homeField as f } from '../lib/edit-fields';

// Lookup tables for the new layout knobs. The focal keyword table lives in
// lib/gallery.ts and is imported above — it was duplicated here, which meant
// the project gallery and the home page could drift apart on what "top-left"
// means.
const headshotShapeCss: Record<string, string> = {
  circle: '50%',
  square: '0.25rem',
  rounded: 'var(--radius-lg)',
};
const logoSizeHeight: Record<string, string> = {
  small: '100px',
  medium: '150px',
  large: '200px',
};

const photoShape = home.hero.headshotShape ?? 'circle';
const photoPosition = home.aboutSection.photoPosition ?? 'left';
const aboutFocal = focalCss(home.aboutSection.photoFocalPoint ?? 'center');
// Crop fields studio writes. Optional: an uncropped photo renders as before.
// Read loosely because home.json is plain JSON with no schema to type them.
const crop = (obj: unknown, focalKey: string, zoomKey: string) => {
  const o = (obj ?? {}) as Record<string, unknown>;
  return {
    focal: focalCss(typeof o[focalKey] === 'string' ? (o[focalKey] as string) : undefined),
    zoom: clampZoom(typeof o[zoomKey] === 'number' ? (o[zoomKey] as number) : undefined),
  };
};
const headshotCrop = crop(home.hero, 'headshotFocalPoint', 'headshotZoom');
const aboutZoom = crop(home.aboutSection, 'photoFocalPoint', 'photoZoom').zoom;
// Untyped view of a home.json row, for optional fields only some rows have.
// (A generic can't be written inside the template: it parses as a tag.)
const loose = (x: unknown) => (x ?? {}) as Record<string, unknown>;
// Layout studio writes (home.json "layout"). All optional: a value that is
// missing keeps the stylesheet's default. Spacing is stored in desktop px and
// scaled by --space-scale on phones, so the page still reflows.
const layout = loose(loose(home).layout);
const layoutSections = loose(layout.sections);
// Added sections (studio's "Add section"), each keyed block:<id> in the order.
const blocks = (Array.isArray(loose(home).blocks) ? (loose(home).blocks as Record<string, unknown>[]) : [])
  .map((block, index) => ({ block, index, key: `block:${String(block.id ?? index)}` }))
  .filter(({ block }) => import.meta.env.DEV || block.draft !== true);
const BUILT_IN = ['hero', 'showcase', 'projects', 'experience', 'about', 'contact'];
const SECTION_KEYS = [...BUILT_IN, ...blocks.map((b) => b.key)];
const sectionOrder = Array.isArray(layout.order)
  ? [...(layout.order as string[]).filter((k) => SECTION_KEYS.includes(k)), ...SECTION_KEYS.filter((k) => !(layout.order as string[]).includes(k))]
  : SECTION_KEYS;
const px = (v: unknown, max = 400) => (typeof v === 'number' && v >= 0 && v <= max ? v : undefined);
const scaled = (n: number) => `calc(${n}px * var(--space-scale, 1))`;
const sectionLayout = (key: string, extra = '') => {
  const s = loose(layoutSections[key]);
  const bits = [`order: ${sectionOrder.indexOf(key)}`];
  const top = px(s.padTop);
  const bottom = px(s.padBottom);
  if (top !== undefined) bits.push(`padding-top: ${scaled(top)}`);
  if (bottom !== undefined) bits.push(`padding-bottom: ${scaled(bottom)}`);
  if (extra) bits.push(extra);
  return bits.join('; ');
};
const gapStyle = (block: string) => {
  const g = px(loose(layout[block]).gap, 200);
  return g === undefined ? undefined : `gap: ${scaled(g)}`;
};
const expSplit = (() => {
  const v = loose(layout.experience).split;
  return typeof v === 'number' && v >= 25 && v <= 75 ? v : 50;
})();
const interestsTop = px(loose(layout.interests).top, 300);
// Dev only: a section switched off still renders in studio, dimmed, carrying
// the home.json path of its show flag so it can be switched back on.
const hiddenAttr = (show: unknown, path: string) => (import.meta.env.DEV ? (show === false ? `off:${path}` : `on:${path}`) : undefined);
const layoutAttr = (key: string) => (import.meta.env.DEV ? key : undefined);
const logoH = logoSizeHeight[home.experienceSection.logoSize ?? 'medium'];
const heroHeadshot = resolveSiteImage(home.hero.headshot);
const aboutPhoto = resolveSiteImage(home.aboutSection.photo);
// Still frame for the collage video, so the tile isn't blank before it loads.
const collagePoster = resolveSiteImage('/src/assets/images/home/aero-testing-poster.jpg');





const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) =>
    a.data.order - b.data.order ||
    b.data.date.valueOf() - a.data.date.valueOf(),
);

// The collage reserves column 1 for the `large` cell and column 2 for `video`,
// each spanning rows 1-2; everything else is a 1x1 cell. Work out how many rows
// that needs so the CSS can scale its aspect ratio to match — a fixed 21/9 with
// fixed rows meant an added photo landed in a collapsed row and disappeared.
/**
 * Crop for a home tile. Both fields are optional — a tile that has never been
 * cropped renders exactly as it did before these existed.
 */
const homeFocal = (value?: string) => focalCss(value);
const homeZoom = (value?: number) => clampZoom(value);

const showcaseItems = home.showcase?.items ?? [];
const hasLarge = showcaseItems.some((x) => x.size === 'large');
const hasVideo = showcaseItems.some((x) => x.size === 'video');
const regularCells = showcaseItems.length - (hasLarge ? 1 : 0) - (hasVideo ? 1 : 0);
const slotsInFirstRows = 4 + (hasLarge ? 0 : 2) + (hasVideo ? 0 : 2);
const collageRows = 2 + Math.ceil(Math.max(0, regularCells - slotsInFirstRows) / 4);

const aboutBioParagraphs = home.aboutSection.bio
  .split(/\n\s*\n+/)
  .map((p) => p.trim())
  .filter(Boolean);
---

<BaseLayout title="Ryan Strawbridge — Mechanical Engineer">
  <div class="home-flow">
  <section class="hero" data-layout={layoutAttr('hero')} style={sectionLayout('hero')}>
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="eyebrow" data-field={f('hero', 'eyebrow')}>{home.hero.eyebrow}</p>
        <h1>Ryan Strawbridge</h1>
        <p class="tagline" data-field={f('hero', 'tagline')} set:html={inlineEmphasis(home.hero.tagline)} />
        {/* Optional. Left blank to keep the hero to name, tagline and buttons. */}
        {home.hero.lede?.trim() && (
          <p class="lede" data-field={f('hero', 'lede')} set:html={inlineEmphasis(home.hero.lede)} />
        )}
        <div class="cta-row">
          <a class="btn" href={home.hero.primaryCta.href} data-field={f('hero', 'primaryCta', 'label')}>{home.hero.primaryCta.label}</a>
          <a
            class="btn btn-resume"
            href={home.hero.secondaryCta.href}
            data-field={f('hero', 'secondaryCta', 'label')}
            target="_blank"
            rel="noopener"
            download={home.hero.secondaryCta.href.endsWith('.pdf') ? '' : undefined}
            data-cta="resume"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>{home.hero.secondaryCta.label}</span>
          </a>
        </div>
      </div>
      <div class="hero-photo" style={`--headshot-radius: ${headshotShapeCss[photoShape]}; --focal: ${headshotCrop.focal}; --zoom: ${headshotCrop.zoom};`} data-field={f('hero', 'headshot')}>
        <Image
          src={heroHeadshot}
          alt={home.hero.headshotAlt ?? 'Headshot of Ryan Strawbridge'}
          widths={[300, 600, 900]}
          sizes="(min-width: 768px) 320px, 60vw"
          class="headshot"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  {(home.showcase?.show !== false || import.meta.env.DEV) && (
    <section class="showcase" data-layout={layoutAttr('showcase')} data-hidden-section={hiddenAttr(home.showcase?.show, 'showcase.show')} style={sectionLayout('showcase')}>
      <div class="container">
        <div class="collage" aria-label="Engineering work in action" style={`--collage-rows: ${collageRows};`}>
          {
            (home.showcase?.items ?? []).map((item, i) => {
              const img = resolveSiteImage(item.image);
              // Cell role drives placement: `large` and `video` are the two
              // dominant cells, each pinned to its own column and spanning both
              // rows. Only the first of each role can take that slot — a second
              // one would be placed on top of it — so any extra falls back to a
              // regular cell rather than overlapping.
              const items = home.showcase?.items ?? [];
              const isFirstOfRole = (role: string) =>
                item.size === role && items.findIndex((x) => x.size === role) === i;
              const dominant = isFirstOfRole('large')
                ? 'collage-large'
                : isFirstOfRole('video')
                  ? 'collage-video'
                  : '';
              const cls = dominant ? `collage-item ${dominant}` : 'collage-item';
              const wide = dominant === 'collage-large';
              return (
                <div
                  class={cls}
                  style={`--focal: ${homeFocal(item.focal)}; --zoom: ${homeZoom(item.zoom)};`}
                  data-field={f('showcase', 'items', i, item.video ? 'video' : 'image')}
                >
                  {item.video ? (
                    /* data-src, not src: an autoplaying <video> downloads the
                       whole file immediately regardless of preload="metadata",
                       which cost every phone visitor 4.7 MB before they'd even
                       scrolled to it. The poster shows instantly and the script
                       below attaches the real source once it's in view — and
                       not at all on a metered connection or reduced motion. */
                    <video
                      muted
                      loop
                      playsinline
                      preload="none"
                      poster={collagePoster?.src}
                      data-src={item.video}
                      aria-label={item.alt}
                    />
                  ) : img ? (
                    <Image
                      src={img}
                      alt={item.alt ?? ''}
                      widths={wide ? [400, 800, 1200] : [400, 800]}
                      sizes={wide ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 768px) 25vw, 50vw'}
                    />
                  ) : null}
                </div>
              );
            })
          }
        </div>
      </div>
    </section>
  )}

  {(home.projectsSection.show !== false || import.meta.env.DEV) && (
    <section class="section" id="projects" data-layout={layoutAttr('projects')} data-hidden-section={hiddenAttr(home.projectsSection.show, 'projectsSection.show')} style={sectionLayout('projects')}>
      <div class="container">
        <div class="section-head">
          <p class="eyebrow" data-field={f('projectsSection', 'eyebrow')}>{home.projectsSection.eyebrow}</p>
          <h2 data-field={f('projectsSection', 'title')}>{home.projectsSection.title}</h2>
        </div>
        <div class="project-grid" data-gap={layoutAttr('projects')} style={gapStyle('projects')}>
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </section>
  )}

  {(home.experienceSection.show !== false || import.meta.env.DEV) && (
  <section class="section experience-section" data-layout={layoutAttr('experience')} data-hidden-section={hiddenAttr(home.experienceSection.show, 'experienceSection.show')} style={sectionLayout('experience', `--logo-height: ${logoH}; --exp-a: ${expSplit}fr; --exp-b: ${100 - expSplit}fr`)}>
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-field={f('experienceSection', 'eyebrow')}>{home.experienceSection.eyebrow}</p>
        <h2 data-field={f('experienceSection', 'title')}>{home.experienceSection.title}</h2>
      </div>
      <ul class="experience-list" data-gap={layoutAttr('experience')} style={gapStyle('experience')}>
        {
          home.experienceSection.items.map((item, i) => {
            const logo = resolveSiteImage(item.logo);
            // Banner fields are optional and only some rows have them, so
            // read them loosely rather than fight the inferred JSON union.
            const row = loose(item);
            const video = typeof row.video === 'string' ? row.video : '';
            const source = typeof row.videoSource === 'string' ? row.videoSource : '';
            const dates = typeof row.dates === 'string' ? row.dates : '';
            const bannerCrop = crop(row, 'focal', 'zoom');
            // Dev only: an untrimmed source still gets a banner slot so studio
            // can preview and cut it. The live site shows a banner once cut.
            const showBanner = video || (import.meta.env.DEV && source);
            return (
              <li class={`experience-card reveal${showBanner ? ' has-banner' : ''}`}>
                <div class="experience-text">
                <header class="experience-head">
                  {logo && (
                    <div class="experience-logo" data-field={f('experienceSection', 'items', i, 'logo')}>
                      <Image src={logo} alt={item.org} widths={[400, 800, 1200]} sizes="(min-width: 768px) 320px, 60vw" loading="lazy" />
                    </div>
                  )}
                  <div class="experience-id">
                    <h3 class="experience-org" data-field={f('experienceSection', 'items', i, 'org')}>{item.org}</h3>
                    <p class="experience-role" data-field={f('experienceSection', 'items', i, 'role')}>{item.role}</p>
                    {(dates || import.meta.env.DEV) && (
                      <p class="experience-dates" data-field={f('experienceSection', 'items', i, 'dates')} data-empty={dates ? undefined : 'Add dates'}>{dates}</p>
                    )}
                  </div>
                </header>
                <p class="experience-blurb muted" data-field={f('experienceSection', 'items', i, 'blurb')}>{item.blurb}</p>
                </div>
                {showBanner && (
                  <div
                    class="experience-banner"
                    data-field={f('experienceSection', 'items', i, 'video')}
                    data-banner={i}
                    data-org={item.org}
                    data-source={import.meta.env.DEV ? source || undefined : undefined}
                    data-start={import.meta.env.DEV ? String(row.videoStart ?? '') : undefined}
                    data-end={import.meta.env.DEV ? String(row.videoEnd ?? '') : undefined}
                    data-cut={video ? 'true' : 'false'}
                    style={`--focal: ${bannerCrop.focal}; --zoom: ${bannerCrop.zoom};`}
                  >
                    <video data-src={video || undefined} muted loop playsinline preload="none" aria-label={`${item.org} video, muted`}></video>
                  </div>
                )}
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
  )}

  {(home.aboutSection.show !== false || import.meta.env.DEV) && (
  <section class={`section about-section about-photo-${photoPosition}`} id="about" data-layout={layoutAttr('about')} data-hidden-section={hiddenAttr(home.aboutSection.show, 'aboutSection.show')} style={sectionLayout('about', `--about-focal: ${aboutFocal}; --about-zoom: ${aboutZoom}`)}>
    <div class="container">
      <div class="about-grid">
        <div class="portrait-wrap" data-field={f('aboutSection', 'photo')}>
          <Image
            src={aboutPhoto}
            alt={home.aboutSection.photoAlt ?? ''}
            widths={[400, 800, 1200]}
            sizes="(min-width: 768px) 380px, 80vw"
            class="portrait"
            loading="lazy"
          />
        </div>
        <div class="about-copy">
          <p class="eyebrow" data-field={f('aboutSection', 'eyebrow')}>{home.aboutSection.eyebrow}</p>
          <h2 data-field={f('aboutSection', 'heading')}>{home.aboutSection.heading}</h2>
          <p class="lede" data-field={f('aboutSection', 'lede')}>{home.aboutSection.lede}</p>
          {aboutBioParagraphs.map((p) => <p data-field={f('aboutSection', 'bio')}>{p}</p>)}
        </div>
      </div>

      {(home.interestsSection.show !== false || import.meta.env.DEV) && (
      <div class="interests" data-hidden-section={hiddenAttr(home.interestsSection.show, 'interestsSection.show')} data-layout-top={layoutAttr('interests')} style={interestsTop === undefined ? undefined : `margin-top: ${scaled(interestsTop)}`}>
        <p class="eyebrow" data-field={f('interestsSection', 'eyebrow')}>{home.interestsSection.eyebrow}</p>
        <div class="interests-grid" data-gap={layoutAttr('interests')} style={gapStyle('interests')}>
          {
            home.interestsSection.items.map((item, i) => {
              const main = resolveSiteImage(item.image);
              const extras = (item.extraImages ?? [])
                .map((path) => resolveSiteImage(path))
                .filter(Boolean);
              return (
                <article class="interest-card reveal">
                  {main && (
                    <div
                      class="interest-image-main"
                      style={`--focal: ${crop(item, 'focal', 'zoom').focal}; --zoom: ${crop(item, 'focal', 'zoom').zoom};`}
                      data-field={f('interestsSection', 'items', i, 'image')}
                    >
                      <Image src={main} alt={item.alt} widths={[400, 800]} sizes="(min-width: 768px) 33vw, 100vw" loading="lazy" />
                    </div>
                  )}
                  {extras.length > 0 && (
                    <div class="interest-thumbs">
                      {extras.map((img, k) => {
                        const c = crop(Array.isArray(loose(item).extraCrops) ? (loose(item).extraCrops as unknown[])[k] : undefined, 'focal', 'zoom');
                        return (
                        <div class="interest-thumb" style={`--focal: ${c.focal}; --zoom: ${c.zoom};`} data-field={f('interestsSection', 'items', i, 'extraImages', k)}>
                          <Image
                            src={img}
                            alt={`${item.title} — photo ${k + 2}`}
                            widths={[200, 400]}
                            sizes="(min-width: 768px) 16vw, 33vw"
                            loading="lazy"
                          />
                        </div>
                        );
                      })}
                    </div>
                  )}
                  <h3 data-field={f('interestsSection', 'items', i, 'title')}>{item.title}</h3>
                  <p class="muted" data-field={f('interestsSection', 'items', i, 'body')}>{item.body}</p>
                </article>
              );
            })
          }
        </div>
      </div>
      )}
    </div>
  </section>
  )}

  {(home.contactSection.show !== false || import.meta.env.DEV) && (
  <section class="section contact-section" id="contact" data-layout={layoutAttr('contact')} data-hidden-section={hiddenAttr(home.contactSection.show, 'contactSection.show')} style={sectionLayout('contact')}>
    <div class="container-narrow contact-inner">
      <p class="eyebrow" data-field={f('contactSection', 'eyebrow')}>{home.contactSection.eyebrow}</p>
      <h2 data-field={f('contactSection', 'heading')}>{home.contactSection.heading}</h2>
      <p class="muted" data-field={f('contactSection', 'body')}>{home.contactSection.body}</p>
      <div class="cta-row">
        <a class="btn" href={`mailto:${home.contactSection.email}`} data-field={f('contactSection', 'email')}>{home.contactSection.email}</a>
        <a class="btn btn-secondary" href={`tel:${home.contactSection.phone.replace(/\D/g, '')}`} data-field={f('contactSection', 'phone')}>
          {home.contactSection.phone}
        </a>
      </div>
    </div>
  </section>
  )}
  {blocks.map(({ block, index, key }) => (
    <SectionBlock block={block} index={index} doc="home" number={sectionOrder.indexOf(key) + 1} sectionStyle={sectionLayout(key)} />
  ))}
  </div>

  <script>
    // The collage video carries data-src instead of src. An autoplaying <video>
    // fetches the entire file as soon as it's parsed — preload="metadata" does
    // not apply once autoplay is set — so the source is attached only when the
    // tile is actually near the viewport.
    //
    // It stays a poster image, and never downloads, when the visitor has asked
    // to reduce motion or their browser reports a metered/slow connection.
    const deferred = document.querySelectorAll('video[data-src]');
    if (deferred.length) {
      const conn = navigator.connection || {};
      const frugal =
        conn.saveData === true ||
        /^(slow-)?2g$/.test(conn.effectiveType || '') ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  
      if (!frugal) {
        const load = (video) => {
          if (video.dataset.loaded) return;
          video.dataset.loaded = '1';
          const source = document.createElement('source');
          source.src = video.dataset.src;
          source.type = 'video/mp4';
          video.appendChild(source);
          video.load();
          video.play().catch(() => {
            // Autoplay refused (iOS low-power mode, for one). The poster and
            // controls are enough; don't make it an error.
            video.setAttribute('controls', '');
          });
        };
  
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                load(entry.target);
                io.unobserve(entry.target);
              }
            },
            { rootMargin: '300px' },
          );
          for (const video of deferred) io.observe(video);
        } else {
          for (const video of deferred) load(video);
        }
      } else {
        // Experience banners have no poster file, so show the clip's first
        // frame, still, with controls, instead of a black box.
        for (const video of document.querySelectorAll('.experience-banner video[data-src]')) {
          video.preload = 'metadata';
          video.src = `${video.dataset.src}#t=0.1`;
          video.setAttribute('controls', '');
        }
      }
    }

    // Banners loop only while on screen: four clips playing off-screen cost
    // battery for nothing.
    if ('IntersectionObserver' in window) {
      const banners = new IntersectionObserver((entries) => {
        for (const { target, isIntersecting } of entries) {
          if (!target.dataset.loaded || target.dataset.studioTrim) continue;
          if (isIntersecting) target.play().catch(() => {});
          else target.pause();
        }
      }, { threshold: 0.15 });
      for (const video of document.querySelectorAll('.experience-banner video')) banners.observe(video);
    }
  </script>


  {/* Dev only. Renders nothing in a production build. */}

  <Lightbox />
  <StudioOverlay mode="home" />

  <script>
    // Track resume-CTA clicks. Replace console.log with analytics call
    // (Plausible, etc.) when ready.
    document.querySelectorAll<HTMLAnchorElement>('a[data-cta="resume"]').forEach((el) => {
      el.addEventListener('click', () => {
        console.log('resume_download', { timestamp: new Date().toISOString() });
      });
    });

    // Subtle parallax for the collage. Each .collage-item gets a small
    // translateY based on how far the collage section has scrolled through
    // the viewport. Different items use different multipliers so they move
    // at slightly different speeds, giving a depth illusion.
    //
    // Disabled on mobile (<= 720px) for perf and on reduced-motion.
    {
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isMobile = window.matchMedia('(max-width: 720px)').matches;
      const collage = document.querySelector<HTMLElement>('.collage');
      if (collage && !prefersReduced && !isMobile && 'IntersectionObserver' in window) {
        const items = Array.from(collage.querySelectorAll<HTMLElement>('.collage-item'));
        // Per-item drift multiplier (px per unit of scroll progress).
        // Subtle — max ~12 px drift on the most-moving cells.
        const speeds = items.map((_, i) => {
          // Alternate pattern so neighbors move opposite directions slightly.
          const base = (i % 2 === 0 ? -1 : 1) * (6 + (i % 3) * 3);
          return base;
        });

        let rafId = 0;
        let inView = false;

        const update = () => {
          rafId = 0;
          const rect = collage.getBoundingClientRect();
          const vh = window.innerHeight;
          // progress: 0 when collage just entered from bottom, 1 when fully past top
          const progress = 1 - (rect.top + rect.height / 2) / vh;
          const clamped = Math.max(-1, Math.min(1, progress));
          items.forEach((el, i) => {
            el.style.transform = `translateY(${(clamped * speeds[i]).toFixed(1)}px)`;
          });
        };

        const schedule = () => {
          if (!inView || rafId) return;
          rafId = requestAnimationFrame(update);
        };

        const io = new IntersectionObserver(
          ([entry]) => {
            inView = entry.isIntersecting;
            if (inView) schedule();
            else {
              if (rafId) cancelAnimationFrame(rafId);
              rafId = 0;
            }
          },
          { threshold: 0, rootMargin: '50px 0px' },
        );
        io.observe(collage);
        window.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', schedule, { passive: true });
        // Initial paint.
        schedule();
      }
    }

  </script>

