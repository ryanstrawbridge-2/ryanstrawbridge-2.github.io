---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TinaEditBridge from '../components/TinaEditBridge.astro';
import home from '../data/home.json';
import { inlineEmphasis } from '../lib/inline-emphasis';
import { resolveSiteImage } from '../lib/site-images';
import { focalCss, clampZoom } from '../lib/gallery';
import StudioOverlay from '../components/StudioOverlay.astro';
import {
  HOME_QUERY,
  HOME_VARIABLES,
  asTinaDocument,
  homeField as f,
  queryId,
} from '../lib/tina-visual-editing';

const tinaId = queryId(HOME_QUERY, HOME_VARIABLES);
const tinaData = { home: asTinaDocument('Home', 'home.json', 'src/data', home) };

// Lookup tables for the new layout knobs. The focal keyword table lives in
// lib/gallery.ts and is imported above — it was duplicated here, which meant
// the project gallery and the home page could drift apart on what "top-left"
// means.
const headshotShapeCss: Record<string, string> = {
  circle: '50%',
  square: '0.25rem',
  rounded: 'var(--radius-lg)',
};
const logoSizeHeight: Record<string, string> = {
  small: '100px',
  medium: '150px',
  large: '200px',
};

const photoShape = home.hero.headshotShape ?? 'circle';
const photoPosition = home.aboutSection.photoPosition ?? 'left';
const aboutFocal = focalCss(home.aboutSection.photoFocalPoint ?? 'center');
// Crop fields studio writes. Optional: an uncropped photo renders as before.
// Read loosely because home.json is plain JSON with no schema to type them.
const crop = (obj: unknown, focalKey: string, zoomKey: string) => {
  const o = (obj ?? {}) as Record<string, unknown>;
  return {
    focal: focalCss(typeof o[focalKey] === 'string' ? (o[focalKey] as string) : undefined),
    zoom: clampZoom(typeof o[zoomKey] === 'number' ? (o[zoomKey] as number) : undefined),
  };
};
const headshotCrop = crop(home.hero, 'headshotFocalPoint', 'headshotZoom');
const aboutZoom = crop(home.aboutSection, 'photoFocalPoint', 'photoZoom').zoom;
const logoH = logoSizeHeight[home.experienceSection.logoSize ?? 'medium'];
const heroHeadshot = resolveSiteImage(home.hero.headshot);
const aboutPhoto = resolveSiteImage(home.aboutSection.photo);
// Still frame for the collage video, so the tile isn't blank before it loads.
const collagePoster = resolveSiteImage('/src/assets/images/home/aero-testing-poster.jpg');





const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) =>
    a.data.order - b.data.order ||
    b.data.date.valueOf() - a.data.date.valueOf(),
);

// The collage reserves column 1 for the `large` cell and column 2 for `video`,
// each spanning rows 1-2; everything else is a 1x1 cell. Work out how many rows
// that needs so the CSS can scale its aspect ratio to match — a fixed 21/9 with
// fixed rows meant an added photo landed in a collapsed row and disappeared.
/**
 * Crop for a home tile. Both fields are optional — a tile that has never been
 * cropped renders exactly as it did before these existed.
 */
const homeFocal = (value?: string) => focalCss(value);
const homeZoom = (value?: number) => clampZoom(value);

const showcaseItems = home.showcase?.items ?? [];
const hasLarge = showcaseItems.some((x) => x.size === 'large');
const hasVideo = showcaseItems.some((x) => x.size === 'video');
const regularCells = showcaseItems.length - (hasLarge ? 1 : 0) - (hasVideo ? 1 : 0);
const slotsInFirstRows = 4 + (hasLarge ? 0 : 2) + (hasVideo ? 0 : 2);
const collageRows = 2 + Math.ceil(Math.max(0, regularCells - slotsInFirstRows) / 4);

const aboutBioParagraphs = home.aboutSection.bio
  .split(/\n\s*\n+/)
  .map((p) => p.trim())
  .filter(Boolean);
---

<BaseLayout title="Ryan Strawbridge — Mechanical Engineer">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="eyebrow" data-tina-field={f('hero', 'eyebrow')}>{home.hero.eyebrow}</p>
        <h1>Ryan Strawbridge</h1>
        <p class="tagline" data-tina-field={f('hero', 'tagline')} set:html={inlineEmphasis(home.hero.tagline)} />
        {/* Optional. Left blank to keep the hero to name, tagline and buttons. */}
        {home.hero.lede?.trim() && (
          <p class="lede" data-tina-field={f('hero', 'lede')} set:html={inlineEmphasis(home.hero.lede)} />
        )}
        <div class="cta-row">
          <a class="btn" href={home.hero.primaryCta.href} data-tina-field={f('hero', 'primaryCta', 'label')}>{home.hero.primaryCta.label}</a>
          <a
            class="btn btn-resume"
            href={home.hero.secondaryCta.href}
            data-tina-field={f('hero', 'secondaryCta', 'label')}
            target="_blank"
            rel="noopener"
            download={home.hero.secondaryCta.href.endsWith('.pdf') ? '' : undefined}
            data-cta="resume"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>{home.hero.secondaryCta.label}</span>
          </a>
        </div>
      </div>
      <div class="hero-photo" style={`--headshot-radius: ${headshotShapeCss[photoShape]}; --focal: ${headshotCrop.focal}; --zoom: ${headshotCrop.zoom};`} data-tina-field={f('hero', 'headshot')}>
        <Image
          src={heroHeadshot}
          alt={home.hero.headshotAlt ?? 'Headshot of Ryan Strawbridge'}
          widths={[300, 600, 900]}
          sizes="(min-width: 768px) 320px, 60vw"
          class="headshot"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  {home.showcase?.show !== false && (
    <section class="showcase">
      <div class="container">
        <div class="collage" aria-label="Engineering work in action" style={`--collage-rows: ${collageRows};`}>
          {
            (home.showcase?.items ?? []).map((item, i) => {
              const img = resolveSiteImage(item.image);
              // Cell role drives placement: `large` and `video` are the two
              // dominant cells, each pinned to its own column and spanning both
              // rows. Only the first of each role can take that slot — a second
              // one would be placed on top of it — so any extra falls back to a
              // regular cell rather than overlapping.
              const items = home.showcase?.items ?? [];
              const isFirstOfRole = (role: string) =>
                item.size === role && items.findIndex((x) => x.size === role) === i;
              const dominant = isFirstOfRole('large')
                ? 'collage-large'
                : isFirstOfRole('video')
                  ? 'collage-video'
                  : '';
              const cls = dominant ? `collage-item ${dominant}` : 'collage-item';
              const wide = dominant === 'collage-large';
              return (
                <div
                  class={cls}
                  style={`--focal: ${homeFocal(item.focal)}; --zoom: ${homeZoom(item.zoom)};`}
                  data-tina-field={f('showcase', 'items', i, item.video ? 'video' : 'image')}
                >
                  {item.video ? (
                    /* data-src, not src: an autoplaying <video> downloads the
                       whole file immediately regardless of preload="metadata",
                       which cost every phone visitor 4.7 MB before they'd even
                       scrolled to it. The poster shows instantly and the script
                       below attaches the real source once it's in view — and
                       not at all on a metered connection or reduced motion. */
                    <video
                      muted
                      loop
                      playsinline
                      preload="none"
                      poster={collagePoster?.src}
                      data-src={item.video}
                      aria-label={item.alt}
                    />
                  ) : img ? (
                    <Image
                      src={img}
                      alt={item.alt ?? ''}
                      widths={wide ? [400, 800, 1200] : [400, 800]}
                      sizes={wide ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 768px) 25vw, 50vw'}
                    />
                  ) : null}
                </div>
              );
            })
          }
        </div>
      </div>
    </section>
  )}

  {home.projectsSection.show !== false && (
    <section class="section" id="projects">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow" data-tina-field={f('projectsSection', 'eyebrow')}>{home.projectsSection.eyebrow}</p>
          <h2 data-tina-field={f('projectsSection', 'title')}>{home.projectsSection.title}</h2>
        </div>
        <div class="project-grid">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </section>
  )}

  {home.experienceSection.show !== false && (
  <section class="section experience-section" style={`--logo-height: ${logoH};`}>
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-tina-field={f('experienceSection', 'eyebrow')}>{home.experienceSection.eyebrow}</p>
        <h2 data-tina-field={f('experienceSection', 'title')}>{home.experienceSection.title}</h2>
      </div>
      <ul class="experience-list">
        {
          home.experienceSection.items.map((item, i) => {
            const logo = resolveSiteImage(item.logo);
            return (
              <li class="experience-card reveal">
                {logo && (
                  <div class="experience-logo" data-tina-field={f('experienceSection', 'items', i, 'logo')}>
                    <Image src={logo} alt={item.org} widths={[400, 800, 1200]} sizes="(min-width: 768px) 33vw, 90vw" loading="lazy" />
                  </div>
                )}
                <div class="experience-body">
                  <p class="experience-role" data-tina-field={f('experienceSection', 'items', i, 'role')}>{item.role}</p>
                  <p class="experience-org" data-tina-field={f('experienceSection', 'items', i, 'org')}>{item.org}</p>
                  <p class="muted" data-tina-field={f('experienceSection', 'items', i, 'blurb')}>{item.blurb}</p>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
  )}

  {home.aboutSection.show !== false && (
  <section class={`section about-section about-photo-${photoPosition}`} id="about" style={`--about-focal: ${aboutFocal}; --about-zoom: ${aboutZoom};`}>
    <div class="container">
      <div class="about-grid">
        <div class="portrait-wrap" data-tina-field={f('aboutSection', 'photo')}>
          <Image
            src={aboutPhoto}
            alt={home.aboutSection.photoAlt ?? ''}
            widths={[400, 800, 1200]}
            sizes="(min-width: 768px) 380px, 80vw"
            class="portrait"
            loading="lazy"
          />
        </div>
        <div class="about-copy">
          <p class="eyebrow" data-tina-field={f('aboutSection', 'eyebrow')}>{home.aboutSection.eyebrow}</p>
          <h2 data-tina-field={f('aboutSection', 'heading')}>{home.aboutSection.heading}</h2>
          <p class="lede" data-tina-field={f('aboutSection', 'lede')}>{home.aboutSection.lede}</p>
          {aboutBioParagraphs.map((p) => <p data-tina-field={f('aboutSection', 'bio')}>{p}</p>)}
        </div>
      </div>

      {home.interestsSection.show !== false && (
      <div class="interests">
        <p class="eyebrow" data-tina-field={f('interestsSection', 'eyebrow')}>{home.interestsSection.eyebrow}</p>
        <div class="interests-grid">
          {
            home.interestsSection.items.map((item, i) => {
              const main = resolveSiteImage(item.image);
              const extras = (item.extraImages ?? [])
                .map((path) => resolveSiteImage(path))
                .filter(Boolean);
              return (
                <article class="interest-card reveal">
                  {main && (
                    <div
                      class="interest-image-main"
                      style={`--focal: ${crop(item, 'focal', 'zoom').focal}; --zoom: ${crop(item, 'focal', 'zoom').zoom};`}
                      data-tina-field={f('interestsSection', 'items', i, 'image')}
                    >
                      <Image src={main} alt={item.alt} widths={[400, 800]} sizes="(min-width: 768px) 33vw, 100vw" loading="lazy" />
                    </div>
                  )}
                  {extras.length > 0 && (
                    <div class="interest-thumbs">
                      {extras.map((img, i) => (
                        <div class="interest-thumb">
                          <Image
                            src={img}
                            alt={`${item.title} — photo ${i + 2}`}
                            widths={[200, 400]}
                            sizes="(min-width: 768px) 16vw, 33vw"
                            loading="lazy"
                          />
                        </div>
                      ))}
                    </div>
                  )}
                  <h3 data-tina-field={f('interestsSection', 'items', i, 'title')}>{item.title}</h3>
                  <p class="muted" data-tina-field={f('interestsSection', 'items', i, 'body')}>{item.body}</p>
                </article>
              );
            })
          }
        </div>
      </div>
      )}
    </div>
  </section>
  )}

  {home.contactSection.show !== false && (
  <section class="section contact-section" id="contact">
    <div class="container-narrow contact-inner">
      <p class="eyebrow" data-tina-field={f('contactSection', 'eyebrow')}>{home.contactSection.eyebrow}</p>
      <h2 data-tina-field={f('contactSection', 'heading')}>{home.contactSection.heading}</h2>
      <p class="muted" data-tina-field={f('contactSection', 'body')}>{home.contactSection.body}</p>
      <div class="cta-row">
        <a class="btn" href={`mailto:${home.contactSection.email}`} data-tina-field={f('contactSection', 'email')}>{home.contactSection.email}</a>
        <a class="btn btn-secondary" href={`tel:${home.contactSection.phone.replace(/\D/g, '')}`} data-tina-field={f('contactSection', 'phone')}>
          {home.contactSection.phone}
        </a>
      </div>
    </div>
  </section>
  )}

  <script>
    // The collage video carries data-src instead of src. An autoplaying <video>
    // fetches the entire file as soon as it's parsed — preload="metadata" does
    // not apply once autoplay is set — so the source is attached only when the
    // tile is actually near the viewport.
    //
    // It stays a poster image, and never downloads, when the visitor has asked
    // to reduce motion or their browser reports a metered/slow connection.
    const deferred = document.querySelectorAll('video[data-src]');
    if (deferred.length) {
      const conn = navigator.connection || {};
      const frugal =
        conn.saveData === true ||
        /^(slow-)?2g$/.test(conn.effectiveType || '') ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  
      if (!frugal) {
        const load = (video) => {
          if (video.dataset.loaded) return;
          video.dataset.loaded = '1';
          const source = document.createElement('source');
          source.src = video.dataset.src;
          source.type = 'video/mp4';
          video.appendChild(source);
          video.load();
          video.play().catch(() => {
            // Autoplay refused (iOS low-power mode, for one). The poster and
            // controls are enough; don't make it an error.
            video.setAttribute('controls', '');
          });
        };
  
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                load(entry.target);
                io.unobserve(entry.target);
              }
            },
            { rootMargin: '300px' },
          );
          for (const video of deferred) io.observe(video);
        } else {
          for (const video of deferred) load(video);
        }
      }
    }
  </script>

  <TinaEditBridge query={HOME_QUERY} variables={HOME_VARIABLES} data={tinaData} id={tinaId} />


  {/* Dev only. Renders nothing in a production build. */}

  <StudioOverlay mode="home" />

  <script>
    // Track resume-CTA clicks. Replace console.log with analytics call
    // (Plausible, etc.) when ready.
    document.querySelectorAll<HTMLAnchorElement>('a[data-cta="resume"]').forEach((el) => {
      el.addEventListener('click', () => {
        console.log('resume_download', { timestamp: new Date().toISOString() });
      });
    });

    // Subtle parallax for the collage. Each .collage-item gets a small
    // translateY based on how far the collage section has scrolled through
    // the viewport. Different items use different multipliers so they move
    // at slightly different speeds, giving a depth illusion.
    //
    // Disabled on mobile (<= 720px) for perf and on reduced-motion.
    {
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isMobile = window.matchMedia('(max-width: 720px)').matches;
      const collage = document.querySelector<HTMLElement>('.collage');
      if (collage && !prefersReduced && !isMobile && 'IntersectionObserver' in window) {
        const items = Array.from(collage.querySelectorAll<HTMLElement>('.collage-item'));
        // Per-item drift multiplier (px per unit of scroll progress).
        // Subtle — max ~12 px drift on the most-moving cells.
        const speeds = items.map((_, i) => {
          // Alternate pattern so neighbors move opposite directions slightly.
          const base = (i % 2 === 0 ? -1 : 1) * (6 + (i % 3) * 3);
          return base;
        });

        let rafId = 0;
        let inView = false;

        const update = () => {
          rafId = 0;
          const rect = collage.getBoundingClientRect();
          const vh = window.innerHeight;
          // progress: 0 when collage just entered from bottom, 1 when fully past top
          const progress = 1 - (rect.top + rect.height / 2) / vh;
          const clamped = Math.max(-1, Math.min(1, progress));
          items.forEach((el, i) => {
            el.style.transform = `translateY(${(clamped * speeds[i]).toFixed(1)}px)`;
          });
        };

        const schedule = () => {
          if (!inView || rafId) return;
          rafId = requestAnimationFrame(update);
        };

        const io = new IntersectionObserver(
          ([entry]) => {
            inView = entry.isIntersecting;
            if (inView) schedule();
            else {
              if (rafId) cancelAnimationFrame(rafId);
              rafId = 0;
            }
          },
          { threshold: 0, rootMargin: '50px 0px' },
        );
        io.observe(collage);
        window.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', schedule, { passive: true });
        // Initial paint.
        schedule();
      }
    }

  </script>

  <style>
    .hero {
      padding-block: 4rem 3rem;
      position: relative;
    }
    @media (min-width: 768px) {
      .hero {
        padding-block: 6rem 3.5rem;
      }
    }
    .hero-grid {
      display: grid;
      gap: 2.5rem;
      align-items: center;
      grid-template-columns: 1fr;
    }
    @media (min-width: 768px) {
      .hero-grid {
        grid-template-columns: 1fr 320px;
        gap: 3.5rem;
      }
    }
    .hero-text {
      max-width: 720px;
    }
    .hero-photo {
      order: -1;
      max-width: 220px;
      margin-inline: 0;
    }
    @media (min-width: 768px) {
      .hero-photo {
        order: 0;
        max-width: 320px;
      }
    }
    /* The wrapper clips and carries the frame, so zoom crops inside the circle
       instead of scaling the border with it. */
    .hero-photo {
      overflow: hidden;
      border-radius: var(--headshot-radius, 50%);
      box-shadow: var(--shadow-lg);
      border: 4px solid var(--bg-elevated);
      line-height: 0;
      align-self: center;
    }
    .hero-photo :global(.headshot) {
      display: block;
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      object-position: var(--focal, center center);
      transform: scale(var(--zoom, 1));
      transform-origin: var(--focal, center center);
    }
    .tagline {
      font-size: clamp(1.25rem, 2.4vw, 1.75rem);
      font-weight: 500;
      line-height: 1.35;
      margin: 1rem 0 1.25rem;
      color: var(--text);
    }
    /* Wrap a phrase in *asterisks* in the CMS to emphasise it. A serif italic
       against the sans headline reads as a deliberate choice rather than a
       browser's default slant. */
    .tagline :global(em) {
      font-family: var(--font-serif, Georgia, 'Times New Roman', serif);
      font-style: italic;
      font-weight: 400;
      /* Serif x-heights run small next to the sans, so nudge the size up. */
      font-size: 1.06em;
      letter-spacing: -0.01em;
    }
    .lede :global(em) {
      font-style: italic;
    }
    .lede {
      font-size: 1.1rem;
      color: var(--text-muted);
      max-width: 640px;
      margin: 0 0 2rem;
    }
    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    /* Résumé CTA — accent-color filled, with download icon, animated hover. */
    :global(.btn-resume) {
      background: var(--accent);
      color: white;
      border-radius: var(--radius-lg);
      gap: 0.5rem;
      padding: 0.75rem 1.25rem;
      font-weight: 600;
      transition:
        background 200ms cubic-bezier(0.2, 0, 0.2, 1),
        transform 200ms cubic-bezier(0.2, 0, 0.2, 1),
        box-shadow 200ms cubic-bezier(0.2, 0, 0.2, 1);
    }
    :global(.btn-resume):hover,
    :global(.btn-resume):focus-visible {
      background: var(--accent-hover);
      color: white;
      transform: translateY(-1px);
      box-shadow: var(--shadow);
    }
    :global(.btn-resume) svg {
      flex-shrink: 0;
    }

    @media (prefers-reduced-motion: reduce) {
      :global(.btn-resume) {
        transition: none;
      }
    }

    .showcase {
      /* Pull the collage up slightly so it overlaps the hero — softens the
         transition between the two sections. */
      padding-block: 0 3rem;
      margin-top: -1.5rem;
      position: relative;
    }
    /* Gradient fade from hero background down into the collage. */
    .showcase::before {
      content: '';
      position: absolute;
      inset: -3rem 0 auto 0;
      height: 3rem;
      background: linear-gradient(to bottom, transparent, var(--bg));
      pointer-events: none;
    }
    /* Collage of engineering work — irregular grid: the welding action shot
       and the aero-testing video are the dominant cells (~1.5x area). Other
       five photos flow around them. */
    .collage {
      display: grid;
      gap: 0.5rem;
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 1fr;
    }
    @media (min-width: 768px) {
      .collage {
        gap: 0.75rem;
        /* 4 columns: feature column (2.4fr) + video column (1.6fr) +
           two side columns. The two dominant cells span rows 1-2; supporting
           cells are 1x1 and fill the remaining slots.

           Rows are auto rather than a fixed `repeat(2, ...)` with an
           aspect-ratio: pinning both meant a 7th photo landed in an implicit
           third row that collapsed to 0px and vanished. Auto rows let extra
           photos added in the CMS grow the collage instead. */
        grid-template-columns: 2.4fr 1.6fr 1fr 1fr;
        grid-template-rows: repeat(var(--collage-rows, 2), minmax(220px, 1fr));
        /* Height scales with row count, so the six-cell layout keeps its
           original 21/9 proportions and extra rows extend it evenly. */
        aspect-ratio: 21 / calc(9 * var(--collage-rows, 2) / 2);
      }
    }
    .collage-item {
      position: relative;
      overflow: hidden;
      border-radius: var(--radius-lg);
      background: var(--bg-elevated);
      aspect-ratio: 4 / 3;
      will-change: transform;
    }
    @media (min-width: 768px) {
      .collage-item {
        aspect-ratio: auto;
      }
      /* Welding-in-action — dominant left cell, spans both rows */
      .collage-large {
        grid-column: 1;
        grid-row: 1 / 3;
      }
      /* Aero-testing video — dominant middle cell, portrait, spans both rows */
      .collage-video {
        grid-column: 2;
        grid-row: 1 / 3;
      }
    }
    .collage-item :global(img),
    .collage-item :global(video) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: var(--focal, center center);
      display: block;
      /* Anchored on the focal point so zoom pushes away from what you
