{
  // Cmd+Shift+P -> "Run Task", or Terminal -> Run Task.

  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start studio (live editor)",
      "detail": "Dev server + live photo editor at localhost:4321 - drag to crop, drop files, browse your library",
      "type": "shell",
      "command": "npm run studio",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Publish site",
      "detail": "Normalize CMS image paths, pull, build, commit, push",
      "type": "shell",
      "command": "npm run publish -- \"${input:commitMessage}\"",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Build resume PDF",
      "detail": "Compile resume/ryan-strawbridge-resume.tex into public/RyanStrawbridgeResume.pdf",
      "type": "shell",
      "command": "npm run resume:build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Build resume PDF, then publish",
      "detail": "Compile the .tex and push the result in one go",
      "type": "shell",
      "command": "npm run resume:build && npm run publish -- \"${input:commitMessage}\"",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Import photos from a folder",
      "detail": "Resize, strip metadata and file everything in photo-inbox/<project-slug>/",
      "type": "shell",
      "command": "npm run photos",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "Commit message",
      "default": "Content update"
    }
  ]
}
